// ══════════════════════════════════════════════════════════════════════════════
// AddStageColumns.gs
// Run ONCE: adds the Marketing Dashboard's Kylas Deals stage columns to OCTOBER 26.
//
//   Daily log (columns H–L, header row "Date | Course Name | …"):
//     Disqualified | Extremely Positive | Reg. Fee Paid | Partial Fee Paid | Enrolled
//     formatted like the Optin column, in every date block.
//   Summary (next free columns after the Milestone Tracker, rows 1–2 = band + headers):
//     Total Disqualified … Total Enrolled = SUMIFS over the daily log, one per campaign row.
//
// AutoFill fills H–L every morning once the dashboard's sheet-results API sends the
// counts (PR "sheet-results: include Kylas Deals stage counts per category").
// setupNextMonth copies the layout into future months. Safe to re-run (skips if present).
// ══════════════════════════════════════════════════════════════════════════════

var STAGE_COLS = {
  TAB: 'OCTOBER 26',
  LOG_HEADERS: ['Disqualified', 'Extremely Positive', 'Reg. Fee Paid', 'Partial Fee Paid', 'Enrolled'],
  BAND: 'Lead Quality & Conversions',
};

function addStageColumns() {
  var ss  = SpreadsheetApp.openById(CONFIG.MAIN_SS_ID);
  var tab = ss.getSheetByName(STAGE_COLS.TAB);
  if (!tab) throw new Error(STAGE_COLS.TAB + ' not found');
  var n = STAGE_COLS.LOG_HEADERS.length;
  var data = tab.getDataRange().getValues();

  // ── Daily log ──────────────────────────────────────────────────────────────
  var hdr = -1;
  for (var i = 0; i < Math.min(30, data.length); i++) {
    if (String(data[i][0]).trim().toLowerCase() === 'date' && String(data[i][1]).trim().toLowerCase() === 'course name') { hdr = i + 1; break; }
  }
  if (hdr === -1) throw new Error('daily log header row not found');
  if (String(tab.getRange(hdr, 8).getValue()).trim() === STAGE_COLS.LOG_HEADERS[0]) {
    Logger.log('⏭ Daily log already has the stage columns.');
  } else {
    var last = tab.getLastRow();
    if (tab.getMaxColumns() < 12) tab.insertColumnsAfter(tab.getMaxColumns(), 12 - tab.getMaxColumns());
    // Header + every log row: copy the Optin column's formatting into H–L
    tab.getRange(hdr, 7, last - hdr + 1, 1).copyTo(tab.getRange(hdr, 8, last - hdr + 1, n), SpreadsheetApp.CopyPasteType.PASTE_FORMAT, false);
    tab.getRange(hdr, 8, 1, n).setValues([STAGE_COLS.LOG_HEADERS]).setWrap(true);
    for (var c = 0; c < n; c++) tab.setColumnWidth(8 + c, Math.max(tab.getColumnWidth(7), 110));
    Logger.log('✅ Daily log: added ' + STAGE_COLS.LOG_HEADERS.join(', ') + ' in H–L (header row ' + hdr + ').');
  }

  // ── Summary totals ─────────────────────────────────────────────────────────
  var head2 = tab.getRange(2, 1, 1, tab.getLastColumn()).getValues()[0].map(function(x) { return String(x).trim(); });
  if (head2.indexOf('Total ' + STAGE_COLS.LOG_HEADERS[0]) !== -1) { Logger.log('⏭ Summary already has the stage totals.'); return; }
  var lastSumRow = 2;
  for (var r = 2; r < hdr - 1; r++) { if (String(data[r][0]).trim()) lastSumRow = r + 1; else break; }
  var firstFree = 1;
  head2.forEach(function(h, idx) { if (h) firstFree = idx + 2; });
  var srcCol = firstFree - 1;                                  // last used summary column (Milestone)
  var rows = lastSumRow - 1;                                   // band row 1 .. last campaign row
  tab.getRange(1, srcCol, rows, 1).copyTo(tab.getRange(1, firstFree, rows, n), SpreadsheetApp.CopyPasteType.PASTE_FORMAT, false);
  tab.getRange(1, firstFree, 1, n).breakApart().merge().setValue(STAGE_COLS.BAND);
  tab.getRange(2, firstFree, 1, n).setValues([STAGE_COLS.LOG_HEADERS.map(function(h) { return 'Total ' + h; })]).setWrap(true);
  var first = hdr + 1;
  for (var r2 = 3; r2 <= lastSumRow; r2++) {
    var f = [];
    for (var k = 0; k < n; k++) {
      var L = String.fromCharCode(72 + k);   // H..L
      f.push('=SUMIFS(' + L + '$' + first + ':' + L + ',$B$' + first + ':$B,$A' + r2 + ')');
    }
    tab.getRange(r2, firstFree, 1, n).setFormulas([f]).setNumberFormat('0');
  }
  Logger.log('✅ Summary: added Total ' + STAGE_COLS.LOG_HEADERS.join(' / ') + ' in columns ' + firstFree + '–' + (firstFree + n - 1) + ', rows 3–' + lastSumRow + '.');
}
