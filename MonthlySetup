// ══════════════════════════════════════════════════════════════════════════════
// MonthlySetup.gs
// One function to prepare next month everywhere the scripts write:
//
//   setupNextMonth()  — run any day in the last week of the month
//     1. SE Daily Ads Report: "<MONTH> <YY>" tab copied from the current month tab
//        (summary, targets, formats, colour rules kept) with one empty date block per
//        day — same campaign rows as the current month — and Milestone dates moved.
//     2. AD Spent workbooks: "DM - <Month>", "SOS - <Month>" (SE) and "AI - <Month>" (SEAI)
//        copied from the current month's tabs, figures cleared, CPR / Total formulas set.
//     3. Checks the result and logs ✅ / ❌.
//   Anything that already exists is skipped, so it is safe to run twice.
//
//   setupMonth(2026, 11) — same, for a specific month (1–12).
//   setupMonthlySetupTrigger() — optional: run setupNextMonth automatically on the 25th.
//
// Needs edit access to the report and both AD Spent workbooks (the account that owns
// the syncMonthlyToAdSpent trigger has it).
// ══════════════════════════════════════════════════════════════════════════════

var MS = {
  REPORT_ID:  '1s7fUe5d0pwg40D4CBzoVbXB6ZYz1Xy8hUQZ2R3Ku-w8',
  FIRST_ROW:  16,   // date blocks start at or after this row
  LOG_COLS:   7,    // A:G — Date, Campaign, Ads Spent, Total Spent, Result, CPR, Optin
  AD_SPENT: [
    { id: '1jCJnYqbHM4Ymrk8-Sp4AwK-XOhRmNroIoFd1GbJmQoM', prefix: 'DM'  },  // SE - 2026 AD Spent data
    { id: '1jCJnYqbHM4Ymrk8-Sp4AwK-XOhRmNroIoFd1GbJmQoM', prefix: 'SOS' },
    { id: '1mBYUJ2QECvYrH6ALdVel1qSM7oRyrMfPdnjeJbDWzNY', prefix: 'AI'  },  // SEAI - 2026 AD Spent data
  ],
  MONTHS: ['January','February','March','April','May','June','July','August','September','October','November','December'],
};

function setupNextMonth() {
  var now = new Date();
  var next = new Date(now.getFullYear(), now.getMonth() + 1, 1);
  setupMonth(next.getFullYear(), next.getMonth() + 1);
}

function setupMonth(year, month) {
  var prev = month === 1 ? { y: year - 1, m: 12 } : { y: year, m: month - 1 };
  Logger.log('═══ Setting up ' + MS.MONTHS[month - 1] + ' ' + year + ' (copying from ' + MS.MONTHS[prev.m - 1] + ' ' + prev.y + ') ═══');
  var problems = [];
  try { msCreateReportTab(year, month, prev); } catch (e) { problems.push('Report tab: ' + e.message); Logger.log('❌ Report tab: ' + e.message); }
  MS.AD_SPENT.forEach(function(w) {
    try { msCreateAdSpentTab(w, month, prev.m); } catch (e) { problems.push(w.prefix + ' AD Spent tab: ' + e.message); Logger.log('❌ ' + w.prefix + ' AD Spent tab: ' + e.message); }
  });
  problems = problems.concat(msVerifyReportTab(year, month));
  if (problems.length) {
    Logger.log('❌ ' + problems.length + ' problem(s):'); problems.forEach(function(p) { Logger.log('  - ' + p); });
    try { sendAlert('Monthly setup for ' + MS.MONTHS[month - 1] + ' ' + year + ' had problems', problems.join('\n')); } catch (e) {}
  } else {
    Logger.log('✅ ' + MS.MONTHS[month - 1] + ' ' + year + ' is set up.');
  }
}

function setupMonthlySetupTrigger() {
  ScriptApp.getProjectTriggers().forEach(function(t) {
    if (t.getHandlerFunction() === 'setupNextMonth') ScriptApp.deleteTrigger(t);
  });
  ScriptApp.newTrigger('setupNextMonth').timeBased().onMonthDay(25).atHour(10).create();
  Logger.log('Trigger set: setupNextMonth on the 25th of every month, 10–11 AM.');
}

// ── 1. REPORT TAB ─────────────────────────────────────────────────────────────
function msTabName(y, m) { return MS.MONTHS[m - 1].toUpperCase() + ' ' + String(y).slice(2); }

function msCreateReportTab(year, month, prev) {
  var ss   = SpreadsheetApp.openById(MS.REPORT_ID);
  var name = msTabName(year, month);
  if (ss.getSheetByName(name)) { Logger.log('⏭ Report tab "' + name + '" already exists — skipped.'); return; }
  var src = ss.getSheetByName(msTabName(prev.y, prev.m));
  if (!src) throw new Error('source tab "' + msTabName(prev.y, prev.m) + '" not found');

  var blocks = msFindBlocks(src);
  if (blocks.length < 2) throw new Error('could not find date blocks in "' + src.getName() + '"');
  var first  = blocks[0].start;
  var period = blocks[1].start - first;             // campaign rows + spacer
  var days   = new Date(year, month, 0).getDate();

  var tab = src.copyTo(ss).setName(name);
  ss.setActiveSheet(tab);
  ss.moveActiveSheet(src.getIndex() + 1);

  var stage = ss.insertSheet('_month_setup_tmp');
  try {
    // One clean block from the source month's first day: keep labels + formulas, drop figures
    src.getRange(first, 1, period, MS.LOG_COLS).copyTo(stage.getRange(1, 1));
    [3, 5, 7].forEach(function(col) { stage.getRange(1, col, period, 1).clearContent(); });

    var lastNeeded = first + days * period - 1;
    if (tab.getMaxRows() < lastNeeded + 5) tab.insertRowsAfter(tab.getMaxRows(), lastNeeded + 5 - tab.getMaxRows());
    var old = tab.getRange(first, 1, tab.getMaxRows() - first + 1, MS.LOG_COLS);
    old.breakApart();
    old.clear();

    for (var d = 0; d < days; d++) {
      var start = first + d * period;
      stage.getRange(1, 1, period, MS.LOG_COLS).copyTo(tab.getRange(start, 1));
      tab.getRange(start, 1).setValue(new Date(year, month - 1, d + 1)).setNumberFormat('d-mmm-yyyy');
    }
  } finally {
    ss.deleteSheet(stage);
  }

  // Milestone (and any other) formulas that hard-code the previous month's dates
  var top = tab.getRange(1, 1, first - 1, tab.getLastColumn());
  var fx  = top.getFormulas(), moved = 0;
  var re  = new RegExp('DATE\\(\\s*' + prev.y + '\\s*,\\s*' + prev.m + '\\s*,', 'g');
  for (var r = 0; r < fx.length; r++) for (var c = 0; c < fx[r].length; c++) {
    if (fx[r][c] && re.test(fx[r][c])) {
      re.lastIndex = 0;
      top.getCell(r + 1, c + 1).setFormula(fx[r][c].replace(re, 'DATE(' + year + ',' + month + ','));
      moved++;
    }
    re.lastIndex = 0;
  }
  SpreadsheetApp.flush();
  Logger.log('✅ Report tab "' + name + '": ' + days + ' date blocks × ' + (period - 1) + ' campaign rows; '
           + moved + ' milestone formulas moved to ' + MS.MONTHS[month - 1] + '. Targets carried over from ' + src.getName() + '.');
}

function msFindBlocks(sheet) {
  var last = sheet.getLastRow();
  var colA = sheet.getRange(MS.FIRST_ROW, 1, Math.max(1, last - MS.FIRST_ROW + 1), 1).getValues();
  var out = [];
  colA.forEach(function(r, i) { if (r[0] instanceof Date) out.push({ start: MS.FIRST_ROW + i, date: r[0] }); });
  return out;
}

function msVerifyReportTab(year, month) {
  var issues = [];
  var tab = SpreadsheetApp.openById(MS.REPORT_ID).getSheetByName(msTabName(year, month));
  if (!tab) return ['report tab "' + msTabName(year, month) + '" missing'];
  var tz = Session.getScriptTimeZone();
  var blocks = msFindBlocks(tab);
  var days = new Date(year, month, 0).getDate();
  if (blocks.length !== days) issues.push(tab.getName() + ': ' + blocks.length + ' date blocks, expected ' + days);
  var period = blocks.length > 1 ? blocks[1].start - blocks[0].start : 0;
  var labels0 = null;
  blocks.forEach(function(b, i) {
    var tag = tab.getName() + ' ' + Utilities.formatDate(b.date, tz, 'd-MMM');
    var want = Utilities.formatDate(new Date(year, month - 1, i + 1), tz, 'yyyy-MM-dd');
    if (Utilities.formatDate(b.date, tz, 'yyyy-MM-dd') !== want) issues.push(tag + ': date should be ' + want);
    var vals = tab.getRange(b.start, 1, period, MS.LOG_COLS).getValues();
    var fx   = tab.getRange(b.start, 1, period, MS.LOG_COLS).getFormulas();
    var labels = vals.map(function(r) { return String(r[1]).trim(); }).filter(String);
    if (!labels0) labels0 = labels.join('|');
    else if (labels.join('|') !== labels0) issues.push(tag + ': campaign rows differ from day 1');
    var n = labels.length;
    if (fx[0][3].replace(/\s/g, '') !== '=SUM(C' + b.start + ':C' + (b.start + n - 1) + ')') issues.push(tag + ': Total Spent is ' + fx[0][3]);
    for (var k = 0; k < n; k++) {
      if (vals[k][2] !== '' || vals[k][4] !== '' || vals[k][6] !== '') { issues.push(tag + ': row ' + (b.start + k) + ' not empty'); break; }
    }
  });
  var disp = tab.getRange(1, 1, MS.FIRST_ROW - 1, tab.getLastColumn()).getDisplayValues();
  disp.forEach(function(row, r) { row.forEach(function(v, c) {
    if (/^#(REF|NAME|VALUE|DIV\/0|N\/A|ERROR)/.test(v)) issues.push(tab.getName() + ': ' + v + ' at row ' + (r + 1) + ' col ' + (c + 1));
  }); });
  if (!issues.length) Logger.log('✅ Checked "' + tab.getName() + '": ' + blocks.length + ' blocks, campaign rows, formulas, summary — OK.');
  return issues;
}

// ── 2. AD SPENT TABS ──────────────────────────────────────────────────────────
function msCreateAdSpentTab(w, month, prevMonth) {
  var ss   = SpreadsheetApp.openById(w.id);
  var to   = w.prefix + ' - ' + MS.MONTHS[month - 1];
  var from = w.prefix + ' - ' + MS.MONTHS[prevMonth - 1];
  if (ss.getSheetByName(to)) { Logger.log('⏭ ' + ss.getName() + ' "' + to + '" already exists — skipped.'); return; }
  var src = ss.getSheetByName(from);
  if (!src) throw new Error('"' + from + '" not found in ' + ss.getName());

  var tab = src.copyTo(ss).setName(to);
  ss.setActiveSheet(tab);
  ss.moveActiveSheet(src.getIndex() + 1);

  var L = msAdsLayout(tab);
  if (!L) throw new Error('"' + to + '" created, but no "Course Name" header / Total row found — clear its figures by hand');
  var first = L.headerRow + 1, last = L.totalRow - 1, total = L.totalRow;
  tab.getRange(first, L.nameCol + 1, total - first + 1, tab.getLastColumn() - L.nameCol).clearContent();

  var col = msColLetter;
  var canCpr = L.cpr > 0 && L.spend > 0 && L.result > 0;
  for (var r = first; r <= last; r++) {
    if (canCpr) tab.getRange(r, L.cpr).setFormula('=IFERROR(' + col(L.spend) + r + '/' + col(L.result) + r + ',0)');
  }
  [L.spend, L.optin, L.result].forEach(function(c) {
    if (c > 0) tab.getRange(total, c).setFormula('=SUM(' + col(c) + first + ':' + col(c) + last + ')');
  });
  if (canCpr) tab.getRange(total, L.cpr).setFormula('=IFERROR(' + col(L.spend) + total + '/' + col(L.result) + total + ',0)');

  var names = tab.getRange(first, L.nameCol, last - first + 1, 1).getValues().map(function(x) { return x[0]; });
  Logger.log('✅ ' + ss.getName() + ' → "' + to + '": ' + names.join(', ') + ' (figures cleared)');
}

function msAdsLayout(tab) {
  var data = tab.getDataRange().getValues();
  for (var r = 0; r < Math.min(10, data.length); r++) {
    var h = data[r].map(function(x) { return String(x || '').trim().toLowerCase(); });
    var nc = h.indexOf('course name');
    if (nc === -1) continue;
    var find = function(words) {
      for (var w = 0; w < words.length; w++) for (var c = 0; c < h.length; c++) if (h[c].indexOf(words[w]) === 0) return c + 1;
      return -1;
    };
    for (var t = r + 1; t < data.length; t++) {
      if (String(data[t][nc] || '').trim().toLowerCase() === 'total') {
        return { headerRow: r + 1, totalRow: t + 1, nameCol: nc + 1,
                 spend: find(['monthly spend', 'spend']), optin: find(['optin']), result: find(['result']), cpr: find(['cpr']) };
      }
    }
    return null;
  }
  return null;
}

function msColLetter(n) {
  var s = '';
  while (n > 0) { var m = (n - 1) % 26; s = String.fromCharCode(65 + m) + s; n = Math.floor((n - 1) / 26); }
  return s;
}
