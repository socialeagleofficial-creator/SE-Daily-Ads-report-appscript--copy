// MK DB API still returns the old course names. For each new course, list the
// old API keys to fall back on (first one found wins).
var MKDB_ALIASES = {
  'DM FREE CALL BOOKING': ['DM'],
  'AI FREE CALL BOOKING': ['AI'],
  'AI MASTERCLASS':       ['AI WORKSHOP'],
  'SOS CALL BOOKING':     ['SOS'],
  'AI MINDSET WEBINAR':   ['THE AI MINDSET WEBINAR'], // dashboard's category name
};

// Match the Marketing Dashboard's per-course rules (src/lib/kpi/category.ts):
//  - DM Direct Calls: Meta's own lead count (Windsor actions_lead) is shown as Opt-ins, Result "—"
//  - Opt-in-only courses: Result "—" on the dashboard (MK DB still returns result = optins), so 0 here
var OPTIN_FROM_META_LEADS = ['DM DIRECT CALLS'];
var RESULTS_NOT_APPLICABLE = [
  'DM FORMS', 'DM WEBSITE VISIT', 'AI WEBSITE VISIT', 'SOS FORMS', 'AI MINDSET WEBINAR', 'DM DIRECT CALLS',
];

function applyDashboardRules(courseData) {
  OPTIN_FROM_META_LEADS.forEach(function(course) {
    var d = courseData[course];
    if (d && !d.optin) d.optin = d.metaLeads || 0;
  });
  RESULTS_NOT_APPLICABLE.forEach(function(course) {
    if (courseData[course]) courseData[course].results = 0;
  });
}

function getMkDbEntry(mkDbResults, course) {
  if (mkDbResults[course]) return mkDbResults[course];
  var aliases = MKDB_ALIASES[course] || [];
  for (var i = 0; i < aliases.length; i++) {
    if (mkDbResults[aliases[i]]) return mkDbResults[aliases[i]];
  }
  return null;
}

// ── VALIDATION ────────────────────────────────────────────────────────────────
function validateConfig() {
  var mappedCourses = CAMPAIGN_MAP.map(function(m) { return m.course; });
  var missing = [];
  mappedCourses.forEach(function(c) {
    if (COURSE_ORDER.indexOf(c) === -1) missing.push(c);
  });
  if (missing.length > 0) {
    throw new Error('CAMPAIGN_MAP courses missing from COURSE_ORDER: ' + missing.join(', '));
  }
  var validTypes = ['purchase', 'lead', 'sheet'];
  CAMPAIGN_MAP.forEach(function(m) {
    if (validTypes.indexOf(m.result_type) === -1) {
      throw new Error('Invalid result_type "' + m.result_type + '" for course ' + m.course);
    }
  });
}

// ── MAIN: runs at 7:00 AM IST every day ──────────────────────────────────────
function morningRun() {
  try { validateConfig(); }
  catch(e) { sendAlert('Config error — AutoFill aborted', e.message); return; }

  var props         = PropertiesService.getScriptProperties();
  var tz            = Session.getScriptTimeZone();
  var now           = new Date();
  var todayStr      = fmtDate(now, tz, 'yyyy-MM-dd');
  var yesterday     = new Date(now); yesterday.setDate(now.getDate() - 1);
  var yesterdayStr  = fmtDate(yesterday, tz, 'yyyy-MM-dd');
  var yesterdayDisp = fmtDate(yesterday, tz, 'd-MMM-yyyy');

  Logger.log('═══ Morning run — closing out: ' + yesterdayStr + ' ═══');

  // ── STEP 1: Fetch results + optins from MK DB ─────────────────────────────
  var mkDbResults = fetchMkDbResults(yesterdayStr);
  if (!mkDbResults) {
    sendAlert(
      'AutoFill WARNING — MK DB API failed for ' + yesterdayStr,
      'Could not fetch results from MK DB. Result and Optin columns will be 0 for '
      + yesterdayStr + '. Run backfillDate("' + yesterdayStr + '") once the API recovers.'
    );
    mkDbResults = {};
  }
  Logger.log('MK DB results: ' + JSON.stringify(mkDbResults));

  // ── STEP 2: End-of-yesterday HW/BO row counts ────────────────────────────
  var hwEnd = countCallBookedRows(CONFIG.HW_SHEET_ID);
  var boEnd = countCallBookedRows(CONFIG.BO_OPTIN_ID);
  Logger.log('End counts → HW: ' + hwEnd + '  BO: ' + boEnd);

  // ── STEP 3: Start-of-yesterday snapshot ──────────────────────────────────
  var hwStartRaw = props.getProperty('hw_start_' + yesterdayStr);
  var boStartRaw = props.getProperty('bo_start_' + yesterdayStr);
  var hwResults = 0, boResults = 0;
  if (hwStartRaw === null || boStartRaw === null) {
    var msg = 'No snapshot for ' + yesterdayStr + '. HW/BO results set to 0.';
    Logger.log('WARNING: ' + msg);
    sendAlert('AutoFill WARNING — missing snapshot', msg);
  } else {
    hwResults = Math.max(0, hwEnd - parseInt(hwStartRaw));
    boResults = Math.max(0, boEnd - parseInt(boStartRaw));
  }
  Logger.log('Sheet call bookings → HW: ' + hwResults + '  BO: ' + boResults);

  // ── STEP 4: Pull Windsor data (spend only) ────────────────────────────────
  var windsorRows = fetchWindsorWithRetry(yesterdayStr, 3);
  if (!windsorRows) {
    sendAlert(
      'AutoFill FAILED — Windsor error for ' + yesterdayStr,
      'Windsor returned no data after 3 attempts. Spend NOT written. '
      + 'Run backfillDate("' + yesterdayStr + '") manually once Windsor recovers.'
    );
    saveSnapshot(props, todayStr, hwEnd, boEnd);
    return;
  }
  Logger.log('Windsor rows: ' + windsorRows.length);

  // ── STEP 5: Aggregate spend by course (Meta + Google Ads) ─────────────────
  var courseData = aggregateByCourse(windsorRows);
  addGoogleAdsSpend(courseData, yesterdayStr);

  // ── STEP 6: Initialise ALL courses to 0, then inject MK DB data ──────────
  // KEY FIX: Every course gets spend/result/optin = 0 by default.
  // This means even paused courses get 0 written to the sheet — not blank.
  // Blank cells block the email trigger; 0 allows it to fire.
  COURSE_ORDER.forEach(function(course) {
    if (!courseData[course]) courseData[course] = { spend: 0, optin: 0, results: 0 };
    // Inject MK DB result + optin (overrides Windsor optin)
    var mkData = getMkDbEntry(mkDbResults, course);
    if (mkData) {
      courseData[course].results = (mkData.result !== undefined) ? mkData.result : 0;
      courseData[course].optin   = (mkData.optin  !== undefined) ? mkData.optin  : 0;
    }
    // If MK DB returned nothing for this course, result and optin stay 0
  });

  applyDashboardRules(courseData);

  // HW/BO: use sheet row-count diff if MK DB returned 0
  ['DM HW PAID', 'DM BO PAID'].forEach(function(course) {
    if (courseData[course].results === 0) {
      var diff = course === 'DM HW PAID' ? hwResults : boResults;
      courseData[course].results = diff;
      Logger.log(course + ': MK DB=0, using sheet diff (' + diff + ')');
    }
  });

  // ── STEP 7: Write to sheet ────────────────────────────────────────────────
  var tabName = fmtDate(yesterday, tz, 'MMMM').toUpperCase()
              + ' ' + fmtDate(yesterday, tz, 'yy');
  var ss    = SpreadsheetApp.openById(CONFIG.MAIN_SS_ID);
  var sheet = ss.getSheetByName(tabName);
  if (!sheet) {
    sendAlert(
      'AutoFill WARNING — tab "' + tabName + '" not found',
      'Data for ' + yesterdayStr + ' NOT written. Create the tab and run '
      + 'backfillDate("' + yesterdayStr + '") manually.'
    );
  } else {
    writeToSheet(sheet, yesterday, yesterdayDisp, courseData, tz);
  }

  // ── STEP 8: Save snapshot for tonight ────────────────────────────────────
  saveSnapshot(props, todayStr, hwEnd, boEnd);
  cleanOldSnapshots(props);
  Logger.log('═══ Morning run complete ═══');
}

// ── FETCH MK DB RESULTS ───────────────────────────────────────────────────────
function fetchMkDbResults(dateStr) {
  var apiKey = PropertiesService.getScriptProperties().getProperty('SHEET_SYNC_API_KEY');
  if (!apiKey) {
    Logger.log('ERROR: SHEET_SYNC_API_KEY not set in Script Properties.');
    return null;
  }
  var url = CONFIG.MKDB_BASE_URL + '/api/sheet-results?date=' + dateStr;
  Logger.log('Calling MK DB API: ' + url);
  try {
    var resp = UrlFetchApp.fetch(url, {
      method: 'GET',
      headers: { 'Authorization': 'Bearer ' + apiKey, 'Content-Type': 'application/json' },
      muteHttpExceptions: true,
    });
    var code = resp.getResponseCode();
    if (code !== 200) {
      Logger.log('MK DB error ' + code + ': ' + resp.getContentText().substring(0, 300));
      return null;
    }
    var json = JSON.parse(resp.getContentText());
    var raw = json.results || {};
    var normalized = {};
    Object.keys(raw).forEach(function(key) { normalized[key.toUpperCase()] = raw[key]; });
    Logger.log('MK DB keys: ' + JSON.stringify(Object.keys(normalized)));
    return normalized;
  } catch(e) {
    Logger.log('MK DB exception: ' + e);
    return null;
  }
}

// ── BACKFILL ──────────────────────────────────────────────────────────────────
function backfillDate(dateStr) {
  validateConfig();
  var tz       = Session.getScriptTimeZone();
  var date     = new Date(dateStr + 'T00:00:00');
  var dispDate = fmtDate(date, tz, 'd-MMM-yyyy');

  var mkDbResults = fetchMkDbResults(dateStr) || {};
  var windsorRows = fetchWindsorWithRetry(dateStr, 3);
  if (!windsorRows) { Logger.log('Windsor failed for ' + dateStr); return; }

  var courseData = aggregateByCourse(windsorRows);
  addGoogleAdsSpend(courseData, dateStr);

  // Initialise all courses to 0
  COURSE_ORDER.forEach(function(course) {
    if (!courseData[course]) courseData[course] = { spend: 0, optin: 0, results: 0 };
    var mkData = getMkDbEntry(mkDbResults, course);
    if (mkData) {
      courseData[course].results = (mkData.result !== undefined) ? mkData.result : 0;
      courseData[course].optin   = (mkData.optin  !== undefined) ? mkData.optin  : 0;
    }
  });

  applyDashboardRules(courseData);

  // HW/BO: if MK DB returned 0, use that day's sheet row-count snapshots (kept 5 days)
  var props   = PropertiesService.getScriptProperties();
  var nextDay = new Date(date); nextDay.setDate(nextDay.getDate() + 1);
  var nextStr = fmtDate(nextDay, tz, 'yyyy-MM-dd');
  [['DM HW PAID', 'hw_start_'], ['DM BO PAID', 'bo_start_']].forEach(function(p) {
    var c = p[0];
    if (!courseData[c]) courseData[c] = { spend: 0, optin: 0, results: 0 };
    if (courseData[c].results !== 0) return;
    var start = props.getProperty(p[1] + dateStr), end = props.getProperty(p[1] + nextStr);
    if (start !== null && end !== null) {
      courseData[c].results = Math.max(0, parseInt(end) - parseInt(start));
      Logger.log(c + ': MK DB=0, using sheet snapshot diff (' + courseData[c].results + ')');
    } else {
      Logger.log(c + ': result is 0 and no snapshots for ' + dateStr + ' — check MK DB or enter manually.');
    }
  });

  var tabName = fmtDate(date, tz, 'MMMM').toUpperCase() + ' ' + fmtDate(date, tz, 'yy');
  var ss    = SpreadsheetApp.openById(CONFIG.MAIN_SS_ID);
  var sheet = ss.getSheetByName(tabName);
  if (!sheet) { Logger.log('Tab not found: ' + tabName); return; }
  writeToSheet(sheet, date, dispDate, courseData, tz);
  Logger.log('Backfill complete for ' + dispDate);
}

// ── DAILY 7-DAY RE-SYNC ───────────────────────────────────────────────────────
// The Marketing Dashboard re-imports the last 7 days of Kylas data every morning (6 AM IST),
// so results for recent days keep changing after morningRun has written them. This refills
// the last 7 days from Windsor + MK DB so the sheet keeps matching the dashboard.
// Runs at 8 AM (after morningRun, before the 9:30 emails). Overwrites manual edits in those rows.
var RESYNC = {
  DAYS:  7,
  FLOOR: '2026-09-22',  // never touch days before the new course rows existed
};

function resyncLast7Days() {
  var tz  = Session.getScriptTimeZone();
  var ok  = [], failed = [];
  for (var i = RESYNC.DAYS; i >= 1; i--) {
    var d = new Date(); d.setDate(d.getDate() - i);
    var dateStr = fmtDate(d, tz, 'yyyy-MM-dd');
    if (dateStr < RESYNC.FLOOR) continue;
    try {
      Logger.log('════ Re-sync ' + dateStr + ' ════');
      backfillDate(dateStr);
      ok.push(dateStr);
    } catch (e) {
      Logger.log('Re-sync failed for ' + dateStr + ': ' + e);
      failed.push(dateStr + ' (' + e.message + ')');
    }
  }
  Logger.log('Re-sync done — refilled: ' + (ok.join(', ') || 'none') + (failed.length ? ' | FAILED: ' + failed.join('; ') : ''));
  if (failed.length) sendAlert('Re-sync failed for ' + failed.length + ' day(s)', failed.join('; '));
}

function setupResyncTrigger() {
  ScriptApp.getProjectTriggers().forEach(function(t) {
    if (t.getHandlerFunction() === 'resyncLast7Days') ScriptApp.deleteTrigger(t);
  });
  ScriptApp.newTrigger('resyncLast7Days').timeBased().everyDays(1).atHour(8).create();
  Logger.log('Trigger set: resyncLast7Days daily at 8 AM.');
}

// ── WINDSOR API ───────────────────────────────────────────────────────────────
function fetchWindsorWithRetry(dateStr, maxAttempts) {
  var apiKey = PropertiesService.getScriptProperties().getProperty('WINDSOR_API_KEY');
  if (!apiKey) { Logger.log('ERROR: WINDSOR_API_KEY not set.'); return null; }
  var fields = 'date,account_id,campaign,campaign_objective,spend,actions_lead,actions_purchase';
  var accountsParam = CONFIG.WINDSOR_ACCOUNTS.join(',');
  var url = CONFIG.WINDSOR_BASE_URL
    + '?api_key='    + apiKey
    + '&date_from='  + dateStr
    + '&date_to='    + dateStr
    + '&fields='     + encodeURIComponent(fields)
    + '&account_ids='+ encodeURIComponent(accountsParam);

  for (var attempt = 1; attempt <= maxAttempts; attempt++) {
    try {
      Logger.log('Windsor attempt ' + attempt + '/' + maxAttempts);
      var resp = UrlFetchApp.fetch(url, { muteHttpExceptions: true });
      if (resp.getResponseCode() === 200) {
        var json = JSON.parse(resp.getContentText());
        var rows = json.data || json || [];
        if (rows.length > 0) return rows;
        Logger.log('Windsor returned 0 rows (attempt ' + attempt + ')');
      } else {
        Logger.log('Windsor HTTP ' + resp.getResponseCode() + ' (attempt ' + attempt + ')');
      }
    } catch(e) {
      Logger.log('Windsor exception (attempt ' + attempt + '): ' + e);
    }
    if (attempt < maxAttempts) Utilities.sleep(5000 * attempt);
  }
  return null;
}

// ── AGGREGATE SPEND FROM WINDSOR ──────────────────────────────────────────────
function aggregateByCourse(rows) {
  var totals = {};
  rows.forEach(function(row) {
    var info = getCourseInfo((row.campaign || '').toString().trim());
    if (!info) return;
    var course = info.course;
    if (!totals[course]) totals[course] = { spend: 0, optin: 0, results: 0, metaLeads: 0 };
    totals[course].spend     += parseFloat(row.spend) || 0;
    totals[course].metaLeads += parseFloat(row.actions_lead) || 0;
  });
  return totals;
}

function getCourseInfo(name) {
  var n = name.toLowerCase();
  for (var i = 0; i < CAMPAIGN_MAP.length; i++) {
    if (n.indexOf(CAMPAIGN_MAP[i].contains.toLowerCase()) !== -1) return CAMPAIGN_MAP[i];
  }
  Logger.log('Unmapped campaign: ' + name);
  return null;
}

// ── WRITE TO SHEET ────────────────────────────────────────────────────────────
// KEY FIX: Always writes 0 explicitly — never leaves cells blank.
// Blank cells = email trigger waits forever. 0 = trigger fires.
//
// Rule:
//   - spend:  write 0 if Windsor had no data (campaign paused)
//   - result: write 0 if MK DB returned 0 or no entry for this course
//   - optin:  write 0 if MK DB returned 0 or no entry for this course
function writeToSheet(sheet, date, dispDate, courseData, tz) {
  var data    = sheet.getDataRange().getValues();
  var numRows = data.length;

  // Find the date block row
  var blockStartRow = -1;
  for (var i = CONFIG.DATA_START_ROW - 1; i < numRows; i++) {
    var cellVal = data[i][0];
    var cellStr = cellVal instanceof Date
      ? fmtDate(new Date(cellVal), tz, 'd-MMM-yyyy')
      : (cellVal || '').toString().trim();
    if (cellStr === dispDate) { blockStartRow = i; break; }
  }

  if (blockStartRow === -1) {
    Logger.log('No pre-built block found for ' + dispDate);
    sendAlert(
      'AutoFill WARNING — date block missing',
      'No row found for ' + dispDate + ' in tab ' + sheet.getName()
      + '. Add the date block and run backfillDate("'
      + fmtDate(date, tz, 'yyyy-MM-dd') + '").'
    );
    return 0;
  }

  // Scan block for course rows
  var courseRows = {};
  for (var i = blockStartRow; i < numRows; i++) {
    var colA = (data[i][0] instanceof Date)
      ? fmtDate(new Date(data[i][0]), tz, 'd-MMM-yyyy')
      : (data[i][0] || '').toString().trim();
    var colB = (data[i][1] || '').toString().trim();
    if (i > blockStartRow && colA !== '' && colA !== dispDate) break;
    if (i > blockStartRow && colA !== '' && !(data[i][0] instanceof Date)) break;
    if (colB !== '') courseRows[colB] = i;
  }
  Logger.log('Block for ' + dispDate + ' — courses: ' + Object.keys(courseRows).join(', '));

  var written = 0;
  Object.keys(courseRows).forEach(function(sheetCourseName) {
    var rowIdx   = courseRows[sheetCourseName];
    var sheetRow = rowIdx + 1; // 1-based
    var courseKey = matchCourseKey(sheetCourseName);
    if (!courseKey) {
      Logger.log('No match for "' + sheetCourseName + '" — skipping.');
      return;
    }

    // Always use 0 as fallback — never leave blank
    var d       = courseData[courseKey] || { spend: 0, optin: 0, results: 0 };
    var spend   = Math.round((d.spend   || 0) * 100) / 100;
    var result  = Math.round(d.results  || 0);
    var optin   = Math.round(d.optin    || 0);
    var cpr     = (result > 0 && spend > 0) ? Math.round(spend / result * 100) / 100 : 0;

    // Write all three columns — 0 is a valid value, never skip it
    sheet.getRange(sheetRow, 3).setValue(spend);   // Col C — Spend
    sheet.getRange(sheetRow, 5).setValue(result);  // Col E — Result
    sheet.getRange(sheetRow, 7).setValue(optin);   // Col G — Optin

    Logger.log('  → ' + sheetCourseName + ' [row ' + sheetRow + ']'
             + '  spend=' + spend
             + '  result=' + result
             + '  optin=' + optin);
    written++;
  });

  // Set date in col A if blank
  if (!data[blockStartRow][0] || data[blockStartRow][0].toString().trim() === '') {
    sheet.getRange(blockStartRow + 1, 1).setValue(date);
    sheet.getRange(blockStartRow + 1, 1).setNumberFormat('d-mmm-yyyy');
  }

  Logger.log('Wrote ' + written + ' course rows for ' + dispDate);
  return written;
}

// ── COURSE KEY MATCHER ────────────────────────────────────────────────────────
function matchCourseKey(sheetCourseName) {
  if (!sheetCourseName) return null;
  // Normalise case and wrapped/double spaces (e.g. a line break inside the cell)
  var name = sheetCourseName.toString().toUpperCase().replace(/\s+/g, ' ').trim();
  if (COURSE_ORDER.indexOf(name) !== -1) return name;
  // Old row names (May–Aug tabs) → current course keys
  var ALIASES = {
    'DM':          'DM FREE CALL BOOKING',
    'AI':          'AI FREE CALL BOOKING',
    'AI WORKSHOP': 'AI MASTERCLASS',
    'SOS':         'SOS CALL BOOKING',
  };
  if (ALIASES[name] !== undefined) return ALIASES[name];
  return null;
}

