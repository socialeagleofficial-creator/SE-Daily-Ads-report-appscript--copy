function countCallBookedRows(ssId) {
  try {
    var ss = SpreadsheetApp.openById(ssId);
    var count = 0;
    ss.getSheets().forEach(function(sheet) {
      var data = sheet.getDataRange().getValues();
      var i = 0;
      while (i < data.length) {
        var row = data[i].map(function(c) { return (c || '').toString().toLowerCase().trim(); });
        var hasTag  = row.some(function(c) { return c === 'unique_tag' || c === 'unique tag'; });
        var hasMeet = row.some(function(c) { return c.indexOf('meeting') !== -1; });
        if (hasTag && hasMeet) {
          i++;
          while (i < data.length) {
            var rowText = data[i].join('').trim();
            if (!rowText) { i++; continue; }
            var nonEmpty = data[i].filter(function(c) { return (c || '').toString().trim() !== ''; });
            var isHeader = nonEmpty.length > 3 && nonEmpty.some(function(c) {
              var s = (c || '').toString().toLowerCase().trim();
              return s === 'name' || s === 'unique_tag' || s === 'lead_type';
            });
            if (isHeader) break;
            count++;
            i++;
          }
        } else { i++; }
      }
    });
    Logger.log('countCallBookedRows [' + ssId.slice(-8) + ']: ' + count);
    return count;
  } catch(e) {
    var msg = 'countCallBookedRows failed [' + ssId + ']: ' + e;
    Logger.log(msg);
    sendAlert('AutoFill WARNING — sheet read error', msg);
    return 0;
  }
}

function saveSnapshot(props, dateStr, hwCount, boCount) {
  props.setProperty('hw_start_' + dateStr, hwCount.toString());
  props.setProperty('bo_start_' + dateStr, boCount.toString());
  Logger.log('Snapshot saved for ' + dateStr + ' → HW: ' + hwCount + '  BO: ' + boCount);
}

function cleanOldSnapshots(props) {
  // Kept 9 days so the 7-day re-sync can still use the HW/BO fallback for its oldest day
  var cutoff = new Date(); cutoff.setDate(cutoff.getDate() - 9);
  props.getKeys().forEach(function(key) {
    var prefix = '';
    if (key.indexOf('hw_start_') === 0) prefix = 'hw_start_';
    if (key.indexOf('bo_start_') === 0) prefix = 'bo_start_';
    if (!prefix) return;
    var keyDate = new Date(key.substring(prefix.length) + 'T00:00:00');
    if (!isNaN(keyDate.getTime()) && keyDate < cutoff) {
      props.deleteProperty(key);
      Logger.log('Cleaned snapshot: ' + key);
    }
  });
}

