/* ══════════════════════════════════════════════════
   LIQUID BLOB CANVAS — matches visionOS glass theme
   Slow-moving colour blobs behind frosted glass cards
══════════════════════════════════════════════════ */
(function(){
  try {
  var c = document.getElementById('bgCanvas');
  if(!c) return;
  var ctx = c.getContext('2d');
  var W, H, blobs = [], t = 0;

  /* Palette: very subtle, deep tones — won't overpower glass */
  var COLORS = [
    [ 60,  40, 120],  // deep indigo
    [ 30,  80, 140],  // deep blue
    [ 80,  30, 120],  // deep purple
    [ 20,  90,  90],  // deep teal
    [ 50,  50, 130],  // deep periwinkle
    [ 90,  20,  80],  // deep magenta
    [ 20,  80, 130],  // deep cyan
    [ 70,  20, 110],  // deep violet
  ];

  function resize(){
    W = c.width = window.innerWidth;
    H = c.height = window.innerHeight;
  }

  function initBlobs(){
    blobs = [];
    var count = 7;
    for(var i = 0; i < count; i++){
      var col = COLORS[i % COLORS.length];
      blobs.push({
        x:  Math.random() * W,
        y:  Math.random() * H,
        r:  Math.min(W,H) * (0.25 + Math.random() * 0.25),
        vx: (Math.random() - 0.5) * 0.4,
        vy: (Math.random() - 0.5) * 0.4,
        col: col,
        phase:  Math.random() * Math.PI * 2,
        speed:  0.0005 + Math.random() * 0.0008,
        wobble: Math.random() * Math.PI * 2,
        wobbleSpeed: 0.001 + Math.random() * 0.001,
        scaleX: 0.8 + Math.random() * 0.4,
        scaleY: 0.8 + Math.random() * 0.4,
      });
    }
  }

  function drawFrame(){
    t += 0.005;
    ctx.clearRect(0, 0, W, H);

    /* Dark navy base */
    var bg = ctx.createLinearGradient(0, 0, W, H);
    bg.addColorStop(0,   '#0f1320');
    bg.addColorStop(0.5, '#141828');
    bg.addColorStop(1,   '#111a2a');
    ctx.fillStyle = bg;
    ctx.fillRect(0, 0, W, H);

    /* Draw glowing blobs */
    ctx.globalCompositeOperation = 'screen';
    blobs.forEach(function(b){
      /* Animate position with Lissajous-style motion */
      b.wobble += b.wobbleSpeed;
      b.phase  += b.speed;

      var tx = Math.sin(b.phase) * W * 0.35 + W * 0.5
             + Math.cos(b.wobble * 0.7) * W * 0.12;
      var ty = Math.cos(b.phase * 0.8) * H * 0.35 + H * 0.5
             + Math.sin(b.wobble * 0.5) * H * 0.10;

      /* Very slow lerp — barely perceptible movement */
      b.x += (tx - b.x) * 0.003;
      b.y += (ty - b.y) * 0.003;

      /* Pulsing size */
      var pulse = 1 + Math.sin(b.wobble * 1.3) * 0.12;
      var rx = b.r * b.scaleX * pulse;
      var ry = b.r * b.scaleY * pulse;

      ctx.save();
      ctx.translate(b.x, b.y);
      ctx.scale(rx / b.r, ry / b.r);

      var grad = ctx.createRadialGradient(0, 0, 0, 0, 0, b.r);
      var col = b.col;
      grad.addColorStop(0,   'rgba('+col[0]+','+col[1]+','+col[2]+',0.7)');
      grad.addColorStop(0.4, 'rgba('+col[0]+','+col[1]+','+col[2]+',0.4)');
      grad.addColorStop(0.75,'rgba('+col[0]+','+col[1]+','+col[2]+',0.12)');
      grad.addColorStop(1,   'rgba('+col[0]+','+col[1]+','+col[2]+',0)');

      ctx.beginPath();
      ctx.arc(0, 0, b.r, 0, Math.PI * 2);
      ctx.fillStyle = grad;
      ctx.fill();
      ctx.restore();
    });

    ctx.globalCompositeOperation = 'source-over';

    /* Subtle dark vignette */
    var vig = ctx.createRadialGradient(W/2,H/2,0,W/2,H/2,Math.max(W,H)*0.65);
    vig.addColorStop(0,'rgba(0,0,0,0)');
    vig.addColorStop(0.6,'rgba(0,0,0,0.15)');
    vig.addColorStop(1,'rgba(0,0,0,0.55)');
    ctx.globalCompositeOperation = 'source-over';
    ctx.fillStyle = vig;
    ctx.fillRect(0,0,W,H);
    /* Extra dark overlay so bg never competes with cards */
    ctx.fillStyle = 'rgba(8,12,22,0.35)';
    ctx.fillRect(0,0,W,H);

    requestAnimationFrame(drawFrame);
  }

  resize();
  initBlobs();
  drawFrame();
  window.addEventListener('resize', function(){ resize(); initBlobs(); });
  }catch(e){ document.getElementById('bgCanvas').style.display='none'; }
})();
</script>
