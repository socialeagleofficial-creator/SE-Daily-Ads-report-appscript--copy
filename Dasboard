<script>
var MONTHS=JSON.parse('<?= months ?>');
var GROUPS=[],allData=null,lazyLoaded={};
var INR=function(v){return'\u20B9'+Number(v).toLocaleString('en-IN',{maximumFractionDigits:0});};
var PCT=function(v){return Number(v).toFixed(2)+'%';};
var FMT=function(v){var n=Number(v);return!n?'0':n%1===0?n.toString():n.toFixed(2);};

function doLogin(){
  var email=(document.getElementById('emailInput').value||'').trim();
  if(!email){showErr('Please enter your email address.');return;}
  var btn=document.getElementById('loginBtn');
  btn.disabled=true;btn.innerHTML='Signing in<span class="spin-sm"></span>';
  document.getElementById('loginErr').style.display='none';
  google.script.run
    .withSuccessHandler(function(j){
      var r=JSON.parse(j);
      if(r.error){showErr(r.error);btn.disabled=false;btn.textContent='Access Dashboard';}
      else{GROUPS=r.groups;showDash(email,r.role);}
    })
    .withFailureHandler(function(){showErr('Connection error. Try again.');btn.disabled=false;btn.textContent='Access Dashboard';})
    .validateEmail(email);
}
function showErr(m){var e=document.getElementById('loginErr');e.textContent=m;e.style.display='block';}
function showDash(email,role){
  document.getElementById('loginScreen').style.display='none';
  document.getElementById('dashScreen').style.display='block';
  document.getElementById('userChip').textContent=email;
  var rp=document.createElement('span');rp.className='role-pill';rp.textContent=role;
  document.getElementById('topbarR').insertBefore(rp,document.getElementById('userChip'));
  document.getElementById('livePill').style.display='flex';
  loadData();
}

function reloadData(){
  allData=null;
  document.getElementById('groupPanels').innerHTML='<div class="global-load"><div class="spin"></div><div class="load-txt">Refreshing...</div></div>';
  loadData();
}

function loadData(){
  google.script.run
    .withSuccessHandler(function(j){
      try{
        allData=JSON.parse(j);
        if(allData.error){document.getElementById('groupPanels').innerHTML='<div class="err-box">'+allData.error+'</div>';return;}
        var t=new Date().toLocaleTimeString('en-IN',{timeZone:'Asia/Kolkata',hour:'2-digit',minute:'2-digit'});
        document.getElementById('lastUpd').innerHTML='<div class="s-dot"></div>Updated '+t+' IST';
        buildUI();
      }catch(e){document.getElementById('groupPanels').innerHTML='<div class="err-box">'+e+'</div>';}
    })
    .withFailureHandler(function(e){document.getElementById('groupPanels').innerHTML='<div class="err-box">'+(e.message||e)+'</div>';})
    .loadCurrentData(JSON.stringify(GROUPS));
}

function buildUI(){
  var te=document.getElementById('groupTabs');te.innerHTML='';
  GROUPS.forEach(function(g,i){
    var b=document.createElement('button');
    b.className='gtab'+(i===0?' active':'');b.id='gtab-'+g;
    b.textContent=(g==='Events'?'Events':g+' Campaigns');b.setAttribute('onclick','showGroup("'+g+'")');
    te.appendChild(b);lazyLoaded[g]={};
  });
  var pe=document.getElementById('groupPanels');pe.innerHTML='';
  GROUPS.forEach(function(g,i){
    var d=document.createElement('div');
    d.className='gpanel'+(i===0?' active':'');d.id='gpanel-'+g;
    d.innerHTML=buildGroup(g);pe.appendChild(d);
  });
}

function showGroup(g){
  GROUPS.forEach(function(gr){
    var t=document.getElementById('gtab-'+gr),p=document.getElementById('gpanel-'+gr);
    if(t)t.className='gtab'+(gr===g?' active':'');
    if(p)p.className='gpanel'+(gr===g?' active':'');
  });
}

function showSec(g,sid){
  var panel=document.getElementById('gpanel-'+g);
  panel.querySelectorAll('.spanel').forEach(function(p){p.className='spanel';});
  panel.querySelectorAll('.sbtn').forEach(function(b){b.className='sbtn';});
  var sp=document.getElementById('sp-'+g+'-'+sid);
  var sb=document.getElementById('sb-'+g+'-'+sid);
  if(sp)sp.className='spanel active';if(sb)sb.className='sbtn active';
  if(sid==='month'&&!lazyLoaded[g].month){lazyLoaded[g].month=true;loadConv(g,getCurMonth());}
  if(sid==='webinar'&&!lazyLoaded[g].webinar){lazyLoaded[g].webinar=true;loadWeb(g);}
}

function buildGroup(g){
  var d=allData[g]||{};
  var secs=[{id:'yesterday',label:'📊 Yesterday'},{id:'week',label:'📅 This Week'},
    {id:'prevweeks',label:'📆 Prev Weeks'},{id:'month',label:'📈 Monthly'},
    {id:'daily',label:'📅 Daily Log'},{id:'webinar',label:'🎯 Webinar'}];
  var h='<div class="section-nav">';
  secs.forEach(function(s,i){
    h+='<button class="sbtn'+(i===0?' active':'')+'" id="sb-'+g+'-'+s.id+'" onclick="showSec(\''+g+'\',\''+s.id+'\')">'+s.label+'</button>';
  });
  h+='</div>';

  h+='<div class="spanel active" id="sp-'+g+'-yesterday">';
  h+=kpiGrid(d.yesterday||[],'mkt')+mktTable(d.yesterday||[],"Yesterday's Performance",false);
  h+='</div>';

  h+='<div class="spanel" id="sp-'+g+'-week">';
  h+=kpiGrid(d.currentWeek||[],'mkt')+mktTable(d.currentWeek||[],'Current Week',true);
  h+='</div>';

  h+='<div class="spanel" id="sp-'+g+'-prevweeks">';
  var pw=d.previousWeeks||[];
  if(!pw.length){h+=empty('No completed weeks yet.');}
  else pw.forEach(function(w,i){
    var ts=w.rows?w.rows.reduce(function(a,r){return a+(r.spend||0);},0):0;
    var open=i===0;
    h+='<div class="week-block"><div class="week-hdr" onclick="togWk(this)">';
    h+='<div style="display:flex;align-items:center;gap:8px;"><span class="wl">'+w.label+'</span><span class="wr">'+w.startStr+' – '+w.endStr+'</span></div>';
    h+='<div style="display:flex;align-items:center;gap:10px;"><span class="wt">'+INR(ts)+'</span><span class="chev'+(open?' open':'')+'">▼</span></div>';
    h+='</div><div class="week-body'+(open?' open':'')+'">';
    h+=mktTable(w.rows||[],'',true)+'</div></div>';
  });
  h+='</div>';

  h+='<div class="spanel" id="sp-'+g+'-month">';
  h+='<div class="month-row"><label>Month</label><select id="msel-'+g+'">';
  var cur=getCurMonth();
  MONTHS.forEach(function(m){h+='<option value="'+m+'"'+(m===cur?' selected':'')+'>'+m+'</option>';});
  h+='</select><button class="load-btn" id="mbtn-'+g+'" onclick="loadMonth(\''+g+'\')">Load</button></div>';
  h+='<div id="mkt-'+g+'">';
  h+=kpiGrid(d.monthly||[],'mkt')+mktTable(d.monthly||[],'Marketing Performance',false);
  h+='</div><div class="divider"></div>';
  h+='<div id="conv-'+g+'"><div class="inline-load"><div class="spin-xs"></div>&nbsp;Loading conversion data...</div></div>';
  h+='</div>';

  h+='<div class="spanel" id="sp-'+g+'-daily">';
  h+=buildDailyLog(d.dailyLog||[],g);
  h+='</div>';

  h+='<div class="spanel" id="sp-'+g+'-webinar">';
  h+='<div id="web-'+g+'"><div class="inline-load"><div class="spin-xs"></div>&nbsp;Loading webinar data...</div></div>';
  h+='</div>';
  return h;
}

function loadConv(g,tab){
  var el=document.getElementById('conv-'+g);if(!el)return;
  google.script.run
    .withSuccessHandler(function(j){
      var r=JSON.parse(j);
      if(r.error){el.innerHTML='<div class="err-box">'+r.error+'</div>';return;}
      var rows=r.conversion||[];
      el.innerHTML=rows.length?convTable(rows,'Conversion Performance'):empty('No conversion data for this month yet.');
    })
    .withFailureHandler(function(e){el.innerHTML='<div class="err-box">'+(e.message||e)+'</div>';})
    .loadConversionTab(g,tab);
}

function loadWeb(g){
  var el=document.getElementById('web-'+g);if(!el)return;
  google.script.run
    .withSuccessHandler(function(j){
      var r=JSON.parse(j);
      if(r.error){el.innerHTML='<div class="err-box">'+r.error+'</div>';return;}
      el.innerHTML=webCards(r.webinars||[],g);
    })
    .withFailureHandler(function(e){el.innerHTML='<div class="err-box">'+(e.message||e)+'</div>';})
    .loadWebinarTab(g);
}

function loadMonth(g){
  var tab=document.getElementById('msel-'+g).value;
  var btn=document.getElementById('mbtn-'+g);
  var mktEl=document.getElementById('mkt-'+g);
  var convEl=document.getElementById('conv-'+g);
  btn.disabled=true;btn.innerHTML='Loading<span class="spin-sm"></span>';
  mktEl.innerHTML='<div class="inline-load"><div class="spin-xs"></div>&nbsp;Loading...</div>';
  convEl.innerHTML='<div class="inline-load"><div class="spin-xs"></div>&nbsp;Loading conversion data...</div>';
  google.script.run
    .withSuccessHandler(function(j){
      var data=JSON.parse(j);var rows=data.marketing||[];
      mktEl.innerHTML=rows.length?kpiGrid(rows,'mkt')+mktTable(rows,tab+' Marketing',false):empty('No data for '+tab+'.');
      btn.disabled=false;btn.textContent='Load';
    })
    .withFailureHandler(function(e){mktEl.innerHTML='<div class="err-box">'+(e.message||e)+'</div>';btn.disabled=false;btn.textContent='Load';})
    .loadMonthData(tab,g);
  google.script.run
    .withSuccessHandler(function(j){
      var r=JSON.parse(j);var rows=r.conversion||[];
      convEl.innerHTML=rows.length?convTable(rows,tab+' Conversion'):empty('No conversion data for '+tab+' yet.');
    })
    .withFailureHandler(function(e){convEl.innerHTML='<div class="err-box">'+(e.message||e)+'</div>';})
    .loadConversionTab(g,tab);
}

function kpiGrid(rows,type){
  if(!rows||!rows.length)return'';
  var h='<div class="kpi-grid">';
  if(type==='mkt'){
    var ts=sum(rows,'spend'),tr=sum(rows,'results'),to=sum(rows,'optin'),tc=tr?ts/tr:0;
    h+=kpi('💰','Total Spend',INR(ts),'Ads deployed today','kc1');
    h+=kpi('🎯','Results',tr,'Conversions driven','kc2');
    h+=kpi('📥','Optins',to,'Leads captured','kc3');
    h+=kpi('📊','Blended CPR',tc?INR(tc):'—','Cost per result','kc4');
  }else{
    var tc2=sum(rows,'conversions'),tr2=sum(rows,'totalRevenue'),ts2=sum(rows,'spend'),tv=sum(rows,'totalConvVal');
    var tR=ts2?tr2/ts2:0;
    h+=kpi('🔄','Conversions',tc2,'Deals closed','kc2');
    h+=kpi('💵','Revenue',INR(tr2),'Total generated','kc2');
    h+=kpi('📦','Conv. Value',INR(tv),'Pipeline value','kc3');
    h+=kpi('📈','ROAS',tR?tR.toFixed(2)+'x':'—','Return on spend','kc4');
  }
  return h+'</div>';
}

function kpi(icon,label,val,sub,cls){
  return'<div class="kpi-card '+cls+'">'+
    '<div class="kpi-icon">'+icon+'</div>'+
    '<div class="kpi-label">'+label+'</div>'+
    '<div class="kpi-value">'+val+'</div>'+
    '<div class="kpi-sub">'+sub+'</div>'+
  '</div>';
}

function mktTable(rows,title,showTotal){
  var maxS=rows.length?Math.max.apply(null,rows.map(function(r){return r.spend||0;})):1;
  var h='<div class="tcard">';
  if(title){
    var ts=sum(rows,'spend');
    h+='<div class="tcard-hdr"><span class="tcard-title">'+title+'</span>';
    h+='<div class="tcard-pills"><span class="tbadge">'+(rows?rows.length:0)+' campaigns</span>';
    if(ts)h+='<span class="tbadge tbadge-hi">'+INR(ts)+'</span>';
    h+='</div></div>';
  }
  if(!rows||!rows.length)return h+'<div class="empty">No data available.</div></div>';
  h+='<table><thead><tr><th>Campaign</th><th>Spend</th><th>Optins</th><th>Results</th><th>CPR</th></tr></thead><tbody>';
  rows.forEach(function(r){
    var pct=maxS>0?Math.round(((r.spend||0)/maxS)*72):0;
    h+='<tr>';
    h+='<td><div class="cname">'+r.name+'</div><div class="clabel">'+r.label+'</div></td>';
    h+='<td class="sc"><div class="sb" style="width:'+pct+'%"></div><span class="sv">'+INR(r.spend)+'</span></td>';
    h+='<td>'+r.optin+'</td><td>'+r.results+'</td>';
    h+='<td>'+(r.cpr?INR(r.cpr):'—')+'</td></tr>';
  });
  if(showTotal){
    var ts=sum(rows,'spend'),tr=sum(rows,'results'),to=sum(rows,'optin'),tc=tr?ts/tr:0;
    h+='<tr class="total-row"><td>Total</td><td>'+INR(ts)+'</td><td>'+to+'</td><td>'+tr+'</td><td>'+(tc?INR(tc):'—')+'</td></tr>';
  }
  return h+'</tbody></table></div>';
}

function convTable(rows, title){
  if(!rows||!rows.length)
    return'<div class="empty">No conversion data.</div>';

  var tSp=sum(rows,'spend'), tRev=sum(rows,'totalRevenue');
  var tRoas=tSp?tRev/tSp:0;

  var h='';

  // Minimal section header
  h+='<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;">';
  h+='<div style="font-size:10px;font-weight:700;color:rgba(255,255,255,0.35);text-transform:uppercase;letter-spacing:1.5px;">'+title+'</div>';
  if(tRoas>0){
    var rColor=tRoas>=2?'#34d399':tRoas>=1?'#fbbf24':'#f87171';
    h+='<div style="font-size:12px;font-weight:800;color:'+rColor+';">Blended RoAS '+tRoas.toFixed(2)+'x</div>';
  }
  h+='</div>';

  rows.forEach(function(r){
    var roasColor=r.roas>=2?'#34d399':r.roas>=1?'#fbbf24':'#f87171';
    var roasBg   =r.roas>=2?'rgba(52,211,153,0.1)':r.roas>=1?'rgba(251,191,36,0.1)':'rgba(248,113,113,0.1)';

    h+='<div class="conv-course-card">';

    // Single header line: name + type + RoAS
    h+='<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">';
    h+='<div style="display:flex;align-items:center;gap:10px;">';
    h+='<span style="font-size:14px;font-weight:800;color:#fff;">'+r.name+'</span>';
    if(r.convType)
      h+='<span style="background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.12);'+
         'border-radius:20px;padding:2px 9px;font-size:11px;color:rgba(255,255,255,0.5);">'+r.convType+'</span>';
    h+='</div>';
    h+='<div style="background:'+roasBg+';border:1px solid '+roasColor+'55;border-radius:10px;'+
       'padding:5px 13px;font-size:13px;font-weight:900;color:'+roasColor+';">'+
       (r.roas?r.roas.toFixed(2)+'x':'—')+' <span style="font-size:9px;opacity:.6;font-weight:600;">RoAS</span></div>';
    h+='</div>';

    // All metrics in ONE flat responsive grid — 4 cols on wide, wraps on narrow
    var metrics=[
      {l:'Spend',        v:INR(r.spend),          c:'#fff'},
      {l:'Optins',       v:r.optin,                c:'#fff'},
      {l:'Results',      v:r.result,               c:'#fff'},
      {l:'CPR',          v:INR(r.cpr),             c:'#fff'},
      {l:'Conversions',  v:r.conversions,           c:'#fff'},
      {l:'Conv. Rate',   v:PCT(r.convRate),         c:'#c4b5fd'},
      {l:'CAC',          v:INR(r.cac),             c:'#fff'},
      {l:'Val / Conv',   v:INR(r.valuePerConv),    c:'#fff'},
      {l:'Conv. Value',  v:INR(r.totalConvVal),    c:'#34d399'},
      {l:'Rev. via Reg', v:INR(r.revThruReg),      c:'#34d399'},
      {l:'Total Revenue',v:INR(r.totalRevenue),    c:'#34d399'}
    ];

    h+='<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:8px;">';
    metrics.forEach(function(m){
      h+='<div style="padding:10px 13px;background:rgba(255,255,255,0.04);'+
         'border:1px solid rgba(255,255,255,0.07);border-radius:10px;">';
      h+='<div style="font-size:9px;font-weight:700;color:rgba(255,255,255,0.32);'+
         'text-transform:uppercase;letter-spacing:.8px;margin-bottom:5px;">'+m.l+'</div>';
      h+='<div style="font-size:15px;font-weight:800;color:'+m.c+';">'+m.v+'</div>';
      h+='</div>';
    });
    h+='</div>';

    h+='</div>'; // end card
  });

  return h;
}


function webCards(tabs,g){
  if(!tabs||!tabs.length)return empty('No webinar data for '+g+'.');
  var h='';

  var moneyKeys=['spend','revenue','cpr','cost','price','value','amount','sale','gross','net'];
  var pctKeys=['conversion rate','purchase rate','lead to purchase','click rate','open rate'];
  // Retention cols — show count + (X%) calculated from paired showup col
  var retentionKeys=['retention','last 45','last 30','last 60'];

  function isMoneyCol(hdr){
    var lo=hdr.toLowerCase();
    // Explicitly exclude attendance/count columns even if they contain money keywords
    var excludeWords=['show up','retention','showup','attendance','viewers','leads','purchase','registrations','registration','interest','conversions','results'];
    if(excludeWords.some(function(e){return lo.indexOf(e)!==-1;})) return false;
    return moneyKeys.some(function(k){return lo.indexOf(k)!==-1;});
  }
  function isPctCol(hdr){
    var lo=hdr.toLowerCase();
    // Only mark as % if header itself contains "rate" as a standalone word
    // or explicitly matches known pct column names
    return pctKeys.some(function(k){return lo.indexOf(k)!==-1;})
      || /rate/.test(lo) || /ratio/.test(lo);
  }
  function isRetentionCol(hdr){
    var lo=hdr.toLowerCase();
    return retentionKeys.some(function(k){return lo.indexOf(k)!==-1;});
  }
  function rawNum(val){
    if(val===''||val===null||val===undefined) return null;
    var n=parseFloat((val+'').replace(/[₹,%\s]/g,'').replace(/,/g,''));
    return isNaN(n)?null:n;
  }
  function fmtNum(n){
    if(n===null||n===undefined) return '—';
    if(n===Math.floor(n)) return n.toLocaleString('en-IN');
    return n.toLocaleString('en-IN',{minimumFractionDigits:0,maximumFractionDigits:2});
  }
  function fmtCell(val,hdr){
    if(val===''||val===null||val===undefined||val==='—') return '—';
    var s=(val+'').trim();
    if(!s) return '—';
    var hasRupee=s.indexOf('₹')!==-1;
    var hasPct=s.indexOf('%')!==-1;
    var n=rawNum(val);
    if(n===null) return s;
    if(hasRupee||isMoneyCol(hdr)) return '₹'+fmtNum(n);
    if(hasPct||isPctCol(hdr)){
      var pv=(!hasPct && n>0 && n<1)?n*100:n;
      return (pv%1===0?pv.toFixed(0):pv.toFixed(2))+'%';
    }
    return fmtNum(n);
  }

  // Find the paired show-up column for a retention column
  // e.g. "Day 1 - Last 45 mins Retention" → look for "Day 1 - Show Up"
  function findShowUpForRetention(headers, retColHdr){
    var lo=retColHdr.toLowerCase();
    // Extract day prefix: "day 1", "day 2", "vip", or none
    var prefix='';
    var m=lo.match(/^(day\s*\d+|vip)/);
    if(m) prefix=m[1];
    // Find a showup col with same prefix
    for(var i=0;i<headers.length;i++){
      var hlo=headers[i].toLowerCase();
      if(hlo.indexOf('show up')===-1) continue;
      if(!prefix) return i; // no prefix — first showup col
      if(hlo.indexOf(prefix)!==-1) return i;
    }
    return -1;
  }

  tabs.forEach(function(tab){
    if(!tab.headers||!tab.rows||!tab.rows.length)return;

    var roasIdx=-1, dateIdx=0, nameIdx=-1;
    tab.headers.forEach(function(hdr,i){
      var lo=hdr.toLowerCase();
      if(lo==='roas') roasIdx=i;
      if(lo==='webinar name'||lo==='name') nameIdx=i;
    });

    h+='<div style="font-size:10px;font-weight:700;color:rgba(255,255,255,0.35);'+
       'text-transform:uppercase;letter-spacing:2px;margin-bottom:16px;">'+tab.tabName+'</div>';

    tab.rows.forEach(function(row,ri){
      var roas=roasIdx>=0?rawNum(row[roasIdx])||0:0;
      var roasColor  =roas>=2?'#34d399':roas>=1?'#fbbf24':'#f87171';
      var roasBg     =roas>=2?'rgba(52,211,153,0.12)':roas>=1?'rgba(251,191,36,0.12)':'rgba(248,113,113,0.12)';
      var roasBorder =roas>=2?'rgba(52,211,153,0.25)':roas>=1?'rgba(251,191,36,0.25)':'rgba(248,113,113,0.25)';
      var dateStr=row[dateIdx]||'';
      var nameStr=nameIdx>=0?row[nameIdx]:tab.tabName;

      h+='<div class="webinar-card" style="margin-bottom:20px;">';

      // Card header
      h+='<div style="display:flex;align-items:center;justify-content:space-between;'+
         'margin-bottom:20px;padding-bottom:16px;border-bottom:1px solid rgba(255,255,255,0.08);">';
      h+='<div>';
      h+='<div style="font-size:16px;font-weight:800;color:#fff;margin-bottom:4px;">'+nameStr+'</div>';
      h+='<div style="font-size:12px;color:rgba(255,255,255,0.4);">'+dateStr+'</div>';
      h+='</div>';
      if(roasIdx>=0){
        h+='<div style="background:'+roasBg+';border:1px solid '+roasBorder+';'+
           'border-radius:16px;padding:10px 20px;text-align:center;min-width:80px;">';
        h+='<div style="font-size:22px;font-weight:900;color:'+roasColor+';letter-spacing:-1px;">'+
           (roas?roas.toFixed(2)+'x':'—')+'</div>';
        h+='<div style="font-size:9px;font-weight:700;color:'+roasColor+';opacity:.65;'+
           'text-transform:uppercase;letter-spacing:1.5px;margin-top:3px;">RoAS</div>';
        h+='</div>';
      }
      h+='</div>';

      // Metrics grid
      h+='<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px;">';
      tab.headers.forEach(function(hdr,ci){
        var lo=hdr.toLowerCase();
        if(ci===dateIdx||lo==='webinar name'||lo==='name'||lo==='roas') return;

        var rawVal=row[ci];
        var isMoney=isMoneyCol(hdr)||(rawVal+'').indexOf('₹')!==-1;
        var isRet=isRetentionCol(hdr);
        var isSpendCpr=lo==='spend'||lo==='cpr'||lo.indexOf('cost')!==-1;

        var valColor=isMoney&&!isSpendCpr?'#34d399':'rgba(255,255,255,0.95)';
        var formatted=fmtCell(rawVal,hdr);

        // For retention — add percentage in brackets
        var retPct='';
        if(isRet){
          var showUpIdx=findShowUpForRetention(tab.headers,hdr);
          if(showUpIdx>=0){
            var showUpN=rawNum(row[showUpIdx]);
            var retN=rawNum(rawVal);
            if(showUpN&&showUpN>0&&retN!==null){
              var pct=Math.round((retN/showUpN)*100);
              retPct=' <span style="font-size:13px;color:rgba(255,255,255,0.45);font-weight:500;">('+pct+'%)</span>';
            }
          }
        }

        h+='<div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.09);'+
           'border-radius:14px;padding:16px 18px;">';
        h+='<div style="font-size:9px;font-weight:700;color:rgba(255,255,255,0.38);'+
           'text-transform:uppercase;letter-spacing:1px;margin-bottom:10px;line-height:1.4;">'+hdr+'</div>';
        h+='<div style="font-size:18px;font-weight:800;color:'+valColor+';letter-spacing:-.3px;">'+
           formatted+retPct+'</div>';
        h+='</div>';
      });
      h+='</div>';
      h+='</div>';
    });
    h+='<div style="height:12px;"></div>';
  });

  return h||empty('No webinar data for '+g+'.');
}
function mt(l,v){return'<div class="metric"><div class="metric-lbl">'+l+'</div><div class="metric-val">'+v+'</div></div>';}
function empty(m){return'<div class="empty">'+m+'</div>';}

function buildDailyLog(days, g){
  if(!days||!days.length) return empty('No daily data available.');
  var h='<div style="display:flex;flex-direction:column;gap:10px;">';
  days.forEach(function(day){
    // Day header row
    h+='<div style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);'+
       'border-radius:16px;overflow:hidden;">';
    // Date label
    h+='<div style="padding:12px 18px;background:rgba(255,255,255,0.04);'+
       'border-bottom:1px solid rgba(255,255,255,0.07);'+
       'display:flex;align-items:center;justify-content:space-between;">';
    h+='<span style="font-size:12px;font-weight:700;color:#fff;">'+day.date+'</span>';
    var ts=day.rows.reduce(function(a,r){return a+(r.spend||0);},0);
    h+='<span style="font-size:12px;font-weight:700;color:rgba(255,255,255,0.5);">'+INR(ts)+'</span>';
    h+='</div>';
    // Course rows as a clean inline table
    h+='<table style="width:100%;border-collapse:collapse;">';
    h+='<thead><tr>';
    ['Campaign','Spend','Optins','Results','CPR'].forEach(function(col,ci){
      h+='<th style="padding:8px 18px;text-align:'+(ci===0?'left':'right')+';'+
         'font-size:9px;font-weight:700;color:rgba(255,255,255,0.3);'+
         'text-transform:uppercase;letter-spacing:1px;border-bottom:1px solid rgba(255,255,255,0.06);">'+col+'</th>';
    });
    h+='</tr></thead><tbody>';
    day.rows.forEach(function(r,ri){
      var bg=ri%2===0?'rgba(255,255,255,0.01)':'transparent';
      h+='<tr style="background:'+bg+';">';
      h+='<td style="padding:10px 18px;text-align:left;">';
      h+='<div style="font-size:13px;font-weight:700;color:#fff;">'+r.name+'</div>';
      h+='<div style="font-size:10px;color:rgba(196,181,253,0.7);margin-top:2px;">'+r.label+'</div>';
      h+='</td>';
      h+='<td style="padding:10px 18px;text-align:right;font-size:13px;font-weight:700;color:#fff;">'+INR(r.spend)+'</td>';
      h+='<td style="padding:10px 18px;text-align:right;font-size:13px;color:rgba(255,255,255,0.85);">'+r.optin+'</td>';
      h+='<td style="padding:10px 18px;text-align:right;font-size:13px;color:rgba(255,255,255,0.85);">'+r.results+'</td>';
      h+='<td style="padding:10px 18px;text-align:right;font-size:13px;color:rgba(255,255,255,0.85);">'+
         (r.cpr?INR(r.cpr):'—')+'</td>';
      h+='</tr>';
    });
    // Day total row
    if(day.rows.length>1){
      var ts=day.rows.reduce(function(a,r){return a+(r.spend||0);},0);
      var tr=day.rows.reduce(function(a,r){return a+(r.results||0);},0);
      var to=day.rows.reduce(function(a,r){return a+(r.optin||0);},0);
      var tc=tr?ts/tr:0;
      h+='<tr style="background:rgba(255,255,255,0.04);border-top:1px solid rgba(255,255,255,0.08);">';
      h+='<td style="padding:10px 18px;font-size:11px;font-weight:700;color:rgba(255,255,255,0.4);">Total</td>';
      h+='<td style="padding:10px 18px;text-align:right;font-size:13px;font-weight:700;color:rgba(196,181,253,0.9);">'+INR(ts)+'</td>';
      h+='<td style="padding:10px 18px;text-align:right;font-size:13px;font-weight:600;color:rgba(196,181,253,0.9);">'+to+'</td>';
      h+='<td style="padding:10px 18px;text-align:right;font-size:13px;font-weight:600;color:rgba(196,181,253,0.9);">'+tr+'</td>';
      h+='<td style="padding:10px 18px;text-align:right;font-size:13px;font-weight:600;color:rgba(196,181,253,0.9);">'+
         (tc?INR(tc):'—')+'</td>';
      h+='</tr>';
    }
    h+='</tbody></table></div>';
  });
  return h+'</div>';
}

