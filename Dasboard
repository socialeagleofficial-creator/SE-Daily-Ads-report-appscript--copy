<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Social Eagle — Ads Intelligence</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap');

:root {
  --bg:      #0d1117;
  --glass:   rgba(255,255,255,0.09);
  --glass2:  rgba(255,255,255,0.14);
  --border:  rgba(255,255,255,0.15);
  --border2: rgba(255,255,255,0.25);
  --t1: #ffffff;
  --t2: #c8d4f0;
  --t3: #7890b8;
  --acc:  #c4b5fd;
  --acc2: #a78bfa;
  --green: #34d399;
  --red:   #f87171;
  --amber: #fbbf24;
  --r:  18px;
  --r2: 24px;
}

* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { width: 100%; min-height: 100vh; overflow-x: hidden; }
body { font-family: 'Inter', system-ui, sans-serif; font-size: 14px; line-height: 1.5; }

/* ── VIDEO BG ── */
#bgVideo {
  position: fixed; inset: 0; z-index: 0;
  width: 100%; height: 100%;
  object-fit: cover;
  opacity: 0.55;
  filter: blur(2px) saturate(1.4) brightness(1.1);
}
/* Frosted overlay — softens video, makes glass readable */


/* ── TOPBAR ── */
.topbar {
  position: sticky; top: 0; z-index: 1000; height: 58px;
  background: rgba(8,12,22,0.95);
  backdrop-filter: blur(32px) saturate(1.8);
  -webkit-backdrop-filter: blur(32px) saturate(1.8);
  border-bottom: 1px solid rgba(255,255,255,0.08);
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 28px;
  box-shadow: 0 1px 0 rgba(255,255,255,0.5), 0 4px 24px rgba(120,80,200,0.08);
}
.brand { display: flex; align-items: center; gap: 12px; }
.brand img { height: 28px; width: auto; }
.brand-text { display: flex; flex-direction: column; }
.brand-name { font-size: 13px; font-weight: 800; letter-spacing: -.2px; color: var(--t1); }
.brand-sub { font-size: 9px; color: rgba(255,255,255,0.45); letter-spacing: 2px; text-transform: uppercase; }
.topbar-r { display: flex; align-items: center; gap: 8px; }
.live-pill {
  display: flex; align-items: center; gap: 5px;
  padding: 4px 11px; border-radius: 20px;
  background: rgba(16,185,129,0.12);
  border: 1px solid rgba(16,185,129,0.3);
  font-size: 10px; font-weight: 700; color: #34d399; letter-spacing: .5px;
}
.ldot { width: 5px; height: 5px; border-radius: 50%; background: #10b981;
  box-shadow: 0 0 6px #10b981; animation: blink 2s ease-in-out infinite; }
@keyframes blink { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.3;transform:scale(.6)} }
.g-chip {
  background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.12);
  border-radius: 20px; padding: 4px 12px;
  font-size: 11px; color: var(--t2); font-weight: 500;
  backdrop-filter: blur(8px);
}
.role-pill {
  background: rgba(124,58,237,0.12); border: 1px solid rgba(124,58,237,0.3);
  border-radius: 20px; padding: 4px 11px;
  font-size: 10px; font-weight: 800; color: var(--acc2);
  letter-spacing: .8px; text-transform: uppercase;
}

/* ── LOGIN ── */
#loginScreen {
  min-height: 100vh; display: flex; align-items: center;
  justify-content: center; position: relative; z-index: 2; padding: 24px;
}
.login-card {
  width: 100%; max-width: 400px;
  background: rgba(16,22,42,0.82);
  backdrop-filter: blur(40px);
  -webkit-backdrop-filter: blur(40px);
  border: 1px solid rgba(255,255,255,0.14);
  border-radius: 32px; padding: 44px;
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.15),
    0 32px 80px rgba(0,0,0,0.6),
    0 0 0 1px rgba(255,255,255,0.05);
  position: relative; overflow: hidden;
}
.login-card::before {
  content: ''; position: absolute; top: 0; left: 10%; right: 10%; height: 1px;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.6), transparent);
}
.login-logo { display: block; height: 32px; margin-bottom: 28px; }
.login-h { font-size: 26px; font-weight: 900; letter-spacing: -.6px; color: var(--t1); margin-bottom: 5px; }
.login-sub { font-size: 12px; color: rgba(255,255,255,0.6); margin-bottom: 28px; line-height: 1.6; }
.fl { margin-bottom: 14px; }
.fl label { display: block; font-size: 10px; font-weight: 700; color: var(--t2);
  text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 7px; color: rgba(255,255,255,0.7); }
.fi {
  width: 100%; padding: 12px 16px;
  background: rgba(255,255,255,0.07);
  border: 1px solid rgba(255,255,255,0.15);
  border-radius: 14px; font-size: 14px; color: #fff;
  font-family: inherit; outline: none;
  transition: all .2s;
}
.fi:focus {
  border-color: var(--acc);
  background: rgba(124,58,237,0.1);
  box-shadow: 0 0 0 3px rgba(124,58,237,0.15);
}
.fi::placeholder { color: var(--t3); }
.login-btn {
  width: 100%; padding: 13px; border: none; border-radius: 14px; margin-top: 4px;
  background: linear-gradient(135deg, rgba(124,58,237,0.9), rgba(91,45,142,0.9));
  color: white; font-size: 14px; font-weight: 700; cursor: pointer;
  font-family: inherit; transition: all .2s;
  backdrop-filter: blur(8px);
  box-shadow: 0 4px 24px rgba(124,58,237,0.3), inset 0 1px 0 rgba(255,255,255,0.2);
}
.login-btn:hover { transform: translateY(-1px); box-shadow: 0 8px 32px rgba(124,58,237,0.4); }
.login-btn:disabled { opacity: .6; cursor: not-allowed; transform: none; }
.login-err {
  display: none; margin-top: 12px;
  background: rgba(220,38,38,0.1); border: 1px solid rgba(220,38,38,0.25);
  border-radius: 12px; padding: 10px 13px; font-size: 12px; color: #991b1b; line-height: 1.5;
}
.login-hint { margin-top: 18px; text-align: center; font-size: 11px; color: rgba(255,255,255,0.4); }

/* ── DASHBOARD ── */
#dashScreen { display: none; position: relative; z-index: 2; }
.main { max-width: 1400px; margin: 0 auto; padding: 22px 22px 80px; }
.dash-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px; }
.dash-info { display: flex; align-items: center; gap: 7px; font-size: 11px; color: rgba(255,255,255,0.65); font-weight: 500; }
.s-dot { width: 5px; height: 5px; border-radius: 50%; background: #10b981; box-shadow: 0 0 6px #10b981; }
.refresh-btn {
  display: flex; align-items: center; gap: 5px; padding: 6px 14px; border-radius: 20px;
  background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.12);
  font-size: 11px; font-weight: 600; color: var(--t1); cursor: pointer;
  backdrop-filter: blur(8px); transition: all .2s; font-family: inherit;
}
.refresh-btn:hover { background: rgba(255,255,255,0.16); }

/* Glass mixin */
.glass {
  background: var(--glass);
  backdrop-filter: blur(24px) saturate(1.8);
  -webkit-backdrop-filter: blur(24px) saturate(1.8);
  border: 1px solid var(--border);
  box-shadow: 0 2px 16px rgba(120,60,200,0.06), inset 0 1px 0 rgba(255,255,255,0.6);
}

/* ── GROUP TABS ── */
.group-tabs {
  display: flex; gap: 3px; margin-bottom: 22px;
  background: rgba(16,22,42,0.8); backdrop-filter: blur(20px);
  border: 1px solid rgba(255,255,255,0.1); border-radius: 20px; padding: 4px; width: fit-content;
  box-shadow: 0 4px 16px rgba(0,0,0,0.3), inset 0 1px 0 rgba(255,255,255,0.08);
}
.gtab {
  padding: 8px 22px; border-radius: 16px; font-size: 11px; font-weight: 700;
  cursor: pointer; border: none; background: transparent; color: var(--t3);
  transition: all .2s; text-transform: uppercase; letter-spacing: .8px; font-family: inherit;
}
.gtab:hover { color: var(--t2); background: rgba(255,255,255,0.25); }
.gtab.active {
  background: rgba(255,255,255,0.12);
  color: #fff; border: 1px solid rgba(255,255,255,0.22);
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.2), 0 2px 12px rgba(0,0,0,0.3);
}
.gpanel { display: none; animation: fadeUp .22s ease; }
.gpanel.active { display: block; }
@keyframes fadeUp { from{opacity:0;transform:translateY(5px)} to{opacity:1;transform:none} }

/* ── SECTION NAV ── */
.section-nav { display: flex; gap: 5px; margin-bottom: 20px; flex-wrap: wrap; }
.sbtn {
  padding: 7px 18px; border-radius: 20px; font-size: 11px; font-weight: 600; cursor: pointer;
  background: rgba(16,22,42,0.7); border: 1px solid rgba(255,255,255,0.1);
  color: rgba(255,255,255,0.55); transition: all .2s; backdrop-filter: blur(8px); font-family: inherit;
}
.sbtn:hover { background: rgba(255,255,255,0.14); color: rgba(255,255,255,0.95); }
.sbtn.active {
  background: rgba(255,255,255,0.12); color: #fff;
  border-color: rgba(255,255,255,0.22);
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.15);
}
.spanel { display: none; animation: fadeUp .2s ease; }
.spanel.active { display: block; }

/* ── KPI CARDS ── */
.kpi-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px,1fr)); gap: 14px; margin-bottom: 16px; }
.kpi-card {
  background: rgba(20,26,46,0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: var(--r2); padding: 22px;
  position: relative; overflow: hidden; cursor: default;
  transition: all .25s cubic-bezier(.4,0,.2,1);
  box-shadow:
    0 8px 32px rgba(0,0,0,0.4),
    inset 0 1px 0 rgba(255,255,255,0.12),
    inset 0 -1px 0 rgba(0,0,0,0.2);
}
.kpi-card::before {
  content: ''; position: absolute; top: 0; left: 15%; right: 15%; height: 1px;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.6), transparent);
}
.kpi-card::after {
  content: ''; position: absolute; top: -50px; right: -50px;
  width: 130px; height: 130px; border-radius: 50%;
  background: radial-gradient(circle, var(--korb, rgba(180,140,255,0.12)) 0%, transparent 70%);
  pointer-events: none;
}
.kpi-card:hover {
  transform: translateY(-3px);
  border-color: rgba(255,255,255,0.45);
  box-shadow:
    0 20px 60px rgba(0,0,0,0.5),
    inset 0 1px 0 rgba(255,255,255,0.45),
    0 0 0 1px rgba(196,181,253,0.2);
}
.kc1 { --korb: rgba(124,58,237,0.1); }
.kc2 { --korb: rgba(5,150,105,0.1); }
.kc3 { --korb: rgba(217,119,6,0.1); }
.kc4 { --korb: rgba(220,38,38,0.08); }

.kpi-icon {
  width: 36px; height: 36px; border-radius: 10px; margin-bottom: 14px;
  display: flex; align-items: center; justify-content: center; font-size: 17px;
  background: rgba(16,22,42,0.8); border: 1px solid rgba(255,255,255,0.12);
}
.kpi-label { font-size: 10px; font-weight: 600; color: rgba(255,255,255,0.65);
  text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 6px; }
.kpi-value {
  font-size: 30px; font-weight: 900; color: var(--t1);
  letter-spacing: -2px; line-height: 1; font-variant-numeric: tabular-nums;
}
.kpi-sub { font-size: 11px; color: rgba(255,255,255,0.55); margin-top: 8px; }

/* ── TABLE CARD ── */
.tcard {
  background: rgba(16,22,42,0.88);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255,255,255,0.10);
  border-radius: var(--r2); overflow: hidden; margin-bottom: 16px;
  box-shadow: 0 8px 32px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.08);
  transition: border-color .2s;
}
.tcard:hover { border-color: rgba(255,255,255,0.7); }
.tcard-hdr {
  padding: 14px 22px;
  background: rgba(0,0,0,0.15);
  border-bottom: 1px solid rgba(255,255,255,0.08);
  display: flex; align-items: center; justify-content: space-between;
}
.tcard-title { font-size: 11px; font-weight: 700; color: rgba(255,255,255,0.8); text-transform: uppercase; letter-spacing: 1px; }
.tcard-pills { display: flex; gap: 6px; }
.tbadge {
  background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.12);
  color: rgba(255,255,255,0.6); font-size: 10px; padding: 2px 9px; border-radius: 20px; font-weight: 600;
}
.tbadge-hi { color: var(--acc); border-color: rgba(124,58,237,0.3); background: rgba(124,58,237,0.08); }

table { width: 100%; border-collapse: collapse; font-size: 13px; }
thead tr { background: rgba(255,255,255,0.12); }
th {
  padding: 11px 18px; text-align: right; color: rgba(255,255,255,0.55); font-weight: 600;
  font-size: 10px; text-transform: uppercase; letter-spacing: 1.2px;
  border-bottom: 1px solid rgba(255,255,255,0.08);
}
th:first-child { text-align: left; }
td { padding: 13px 18px; text-align: right; border-bottom: 1px solid rgba(255,255,255,0.08); transition: background .15s; color: rgba(255,255,255,0.9); font-weight: 500; }
td:first-child { text-align: left; }
tr:last-child td { border-bottom: none; }
tbody tr:hover td { background: rgba(255,255,255,0.08); }
.cname { font-weight: 700; color: #fff; }
.clabel { font-size: 10px; color: rgba(196,181,253,0.9); font-weight: 600; margin-top: 2px; }
.val-n { font-weight: 700; color: #fff; font-variant-numeric: tabular-nums; }
.val-g { color: #34d399; font-weight: 700; }
.val-b { color: #c4b5fd; }
/* spend bar behind cell */
.sc { position: relative; }
.sb { position: absolute; left: 0; top: 0; bottom: 0;
  background: linear-gradient(90deg, rgba(167,139,250,0.15), rgba(124,58,237,0.03));
  border-radius: 0 4px 4px 0; pointer-events: none; transition: width .5s ease; }
.sv { position: relative; z-index: 1; font-weight: 700; color: #fff; font-variant-numeric: tabular-nums; }
.total-row td { background: rgba(255,255,255,0.12) !important; color: var(--t1); font-weight: 800; border-top: 1px solid rgba(255,255,255,0.2); }
.roas-tag { display: inline-block; padding: 2px 9px; border-radius: 8px; font-size: 12px; font-weight: 800; }
.rg { background: rgba(16,185,129,0.15); color: #34d399; }
.ra { background: rgba(251,191,36,0.15); color: #fbbf24; }
.rr { background: rgba(248,113,113,0.15); color: #f87171; }

/* ── WEEK ACCORDION ── */
.week-block { margin-bottom: 8px; }
.week-hdr {
  display: flex; align-items: center; justify-content: space-between;
  padding: 12px 18px;
  background: rgba(16,22,42,0.8); backdrop-filter: blur(20px);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 16px; cursor: pointer; transition: all .2s;
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.08);
}
.week-hdr:hover { background: rgba(28,36,62,0.9); border-color: rgba(255,255,255,0.18); }
.wl { font-weight: 700; color: var(--t1); font-size: 12px; }
.wr { font-size: 11px; color: rgba(255,255,255,0.45); margin-left: 8px; }
.wt { font-size: 11px; color: #c4b5fd; font-weight: 700; }
.chev { color: var(--t3); transition: transform .25s; font-size: 10px; }
.chev.open { transform: rotate(180deg); }
.week-body { display: none; padding-top: 6px; }
.week-body.open { display: block; animation: fadeUp .2s ease; }

/* ── MONTH ── */
.month-row { display: flex; align-items: center; gap: 10px; margin-bottom: 18px; }
.month-row label { font-size: 10px; font-weight: 700; color: var(--t2); text-transform: uppercase; letter-spacing: 1.5px; }
select {
  padding: 8px 14px;
  background: rgba(16,22,42,0.8); border: 1px solid rgba(255,255,255,0.12);
  border-radius: 12px; font-size: 12px; color: var(--t1); cursor: pointer;
  font-weight: 600; outline: none; font-family: inherit;
  backdrop-filter: blur(8px); transition: all .2s;
}
select:focus { border-color: rgba(124,58,237,0.4); }
.load-btn {
  padding: 8px 18px; border-radius: 12px;
  background: linear-gradient(135deg, rgba(124,58,237,0.85), rgba(91,45,142,0.85));
  color: white; font-size: 11px; font-weight: 700; border: none; cursor: pointer;
  font-family: inherit; transition: all .2s; backdrop-filter: blur(8px);
  box-shadow: 0 4px 16px rgba(124,58,237,0.25), inset 0 1px 0 rgba(255,255,255,0.2);
}
.load-btn:hover { transform: translateY(-1px); box-shadow: 0 8px 24px rgba(124,58,237,0.35); }
.load-btn:disabled { opacity: .5; cursor: not-allowed; transform: none; }

/* ── WEBINAR ── */
.webinar-card {
  background: rgba(16,22,42,0.85); backdrop-filter: blur(20px);
  border: 1px solid rgba(255,255,255,0.1); border-radius: var(--r2);
  box-shadow: 0 8px 32px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.08);
  padding: 22px; margin-bottom: 14px; transition: all .25s; position: relative; overflow: hidden;
}
.webinar-card::before {
  content: ''; position: absolute; top: 0; left: 10%; right: 10%; height: 1px;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.6), transparent);
}
.webinar-card:hover { border-color: rgba(255,255,255,0.7); transform: translateY(-1px); box-shadow: 0 12px 40px rgba(120,60,200,0.1); }
.webinar-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 18px; padding-bottom: 14px; border-bottom: 1px solid rgba(255,255,255,0.08); }
.webinar-name { font-size: 15px; font-weight: 800; color: var(--t1); letter-spacing: -.3px; }
.webinar-date { font-size: 11px; color: var(--t3); margin-top: 3px; }
.roas-pill {
  padding: 7px 16px; border-radius: 20px; font-size: 13px; font-weight: 900;
  border: 1px solid; backdrop-filter: blur(8px);
}
.roas-pill.g { background: rgba(16,185,129,0.15); color: #34d399; border-color: rgba(16,185,129,0.3); }
.roas-pill.a { background: rgba(251,191,36,0.15); color: #fbbf24; border-color: rgba(251,191,36,0.3); }
.roas-pill.r { background: rgba(248,113,113,0.15); color: #f87171; border-color: rgba(248,113,113,0.3); }

.metrics-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px,1fr)); gap: 9px; }
.metric {
  background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1);
  border-radius: 14px; padding: 12px 14px; transition: all .2s;
}
.metric:hover { background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.2); }
.metric-lbl { font-size: 9px; font-weight: 600; color: rgba(255,255,255,0.55); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 5px; }
.metric-val { font-size: 16px; font-weight: 800; color: var(--t1); letter-spacing: -.5px; }

/* ── STATES ── */
.divider { height: 1px; background: rgba(255,255,255,0.3); margin: 22px 0; }
.empty {
  text-align: center; padding: 48px 24px; color: var(--t3); font-size: 13px;
  background: rgba(16,22,42,0.8); border: 1px solid rgba(255,255,255,0.1);
  border-radius: var(--r2); backdrop-filter: blur(16px);
}
.global-load { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 80px; gap: 16px; }
.inline-load { display: flex; align-items: center; gap: 8px; padding: 24px 16px; color: var(--t3); font-size: 12px; }
.spin {
  width: 32px; height: 32px;
  border: 2px solid rgba(255,255,255,0.3);
  border-top-color: var(--acc2);
  border-radius: 50%; animation: spin .75s linear infinite;
}
.spin-sm { display: inline-block; width: 11px; height: 11px; border: 1.5px solid rgba(255,255,255,.4); border-top-color: white; border-radius: 50%; animation: spin .75s linear infinite; vertical-align: middle; margin-left: 5px; }
.spin-xs { display: inline-block; width: 9px; height: 9px; border: 1.5px solid rgba(255,255,255,.3); border-top-color: var(--acc2); border-radius: 50%; animation: spin .75s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.load-txt { color: var(--t2); font-size: 12px; font-weight: 500; }
.err-box { background: rgba(220,38,38,0.1); border: 1px solid rgba(220,38,38,0.25); border-radius: 14px; padding: 13px; color: #991b1b; font-size: 12px; margin-bottom: 14px; }






.conv-course-card {
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 18px; padding: 20px 22px;
  margin-bottom: 12px; transition: border-color .2s;
}
.conv-course-card:hover { border-color: rgba(255,255,255,0.2); }
</style>
</head>
<body>

<!-- VIDEO BACKGROUND -->
<!-- Animated canvas background -->
<canvas id="bgCanvas" style="position:fixed;inset:0;z-index:0;width:100%;height:100%;pointer-events:none;"></canvas>


<!-- TOPBAR -->
<div class="topbar">
  <div class="brand">
    <img src="https://www.socialeagle.in/logo-white.png" alt="Social Eagle" style="filter:brightness(0) invert(1); opacity:0.9;">
    <div class="brand-text">
      <div class="brand-name">Social Eagle</div>
      <div class="brand-sub">Ads Intelligence</div>
