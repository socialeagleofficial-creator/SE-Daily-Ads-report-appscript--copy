// ══════════════════════════════════════════════════════════════════════════════
// AuditMissing.gs
// Finds missing / wrong Spend, Result and Optin cells in the daily blocks by comparing
// the sheet with what AutoFill would write today (Windsor + Google Ads + MK DB +
// Meta fallbacks — the same buildDayData() that backfillDate uses).
//
//   auditMissingValues()  — READ ONLY. Every day from 22 Sep 2026 to yesterday. Logs:
//       MISSING   sheet is 0/blank, sources have a number
//       DIFFERS   both have numbers but they disagree
//       NO DATA   the campaign spent money but the sources have 0 optins and 0 results
//     and a per-campaign summary at the end.
//
//   fillMissingValues()   — writes ONLY the MISSING cells (0/blank in the sheet, source > 0)
//     for the same dates. Never overwrites a non-zero cell, so manual edits are kept.
//
//   matchDashboardValues() — MISSING cells plus Result/Optin cells that DIFFER from the
//     dashboard (MK DB) now. Spend differences (Meta's small late revisions) are left alone,
//     as are cells where the source has 0.
// ══════════════════════════════════════════════════════════════════════════════

var AUDIT_FROM = '2026-09-22';   // first day with the new campaign rows

function auditMissingValues()   { auditRange(AUDIT_FROM, auditYesterday(), 'audit'); }
function fillMissingValues()    { auditRange(AUDIT_FROM, auditYesterday(), 'fill');  }
function matchDashboardValues() { auditRange(AUDIT_FROM, auditYesterday(), 'match'); }

function auditYesterday() {
  var d = new Date(); d.setDate(d.getDate() - 1);
  return fmtDate(d, Session.getScriptTimeZone(), 'yyyy-MM-dd');
}

function auditRange(fromStr, toStr, mode, onlyNames) {
  var fill = mode === 'fill' || mode === 'match' || mode === 'matchSpend';
  var tz = Session.getScriptTimeZone();
  var ss = SpreadsheetApp.openById(CONFIG.MAIN_SS_ID);
  var FIELDS = [{ name: 'Spend', col: 3, key: 'spend' }, { name: 'Result', col: 5, key: 'results' }, { name: 'Optin', col: 7, key: 'optin' }];
  var tally = {}, counts = { MISSING: 0, DIFFERS: 0, 'NO DATA': 0, filled: 0 };

  Logger.log(mode.toUpperCase() + ' ' + fromStr + ' → ' + toStr + '   (sheet value vs source value)');
  for (var d = new Date(fromStr + 'T00:00:00'); fmtDate(d, tz, 'yyyy-MM-dd') <= toStr; d.setDate(d.getDate() + 1)) {
    var dateStr = fmtDate(d, tz, 'yyyy-MM-dd');
    var sheet = ss.getSheetByName(fmtDate(d, tz, 'MMMM').toUpperCase() + ' ' + fmtDate(d, tz, 'yy'));
    if (!sheet) { Logger.log('── ' + dateStr + ': month tab not found'); continue; }
    var rows = auditBlockRows(sheet, fmtDate(d, tz, 'd-MMM-yyyy'), tz);
    if (!rows.length) { Logger.log('── ' + dateStr + ': no date block'); continue; }
    var b = buildDayData(dateStr);
    if (!b) { Logger.log('── ' + dateStr + ': Windsor failed — skipped'); continue; }

    var lines = [];
    rows.forEach(function(r) {
      if (onlyNames && !onlyNames.test(r.name)) return;
      var key = matchCourseKey(r.name);
      if (!key) return;
      var src = b.courseData[key] || { spend: 0, results: 0, optin: 0 };
      var want = { spend: Math.round((src.spend || 0) * 100) / 100, results: Math.round(src.results || 0), optin: Math.round(src.optin || 0) };
      FIELDS.forEach(function(f) {
        var have = r.values[f.col - 1], haveNum = Number(have) || 0, w = want[f.key];
        var close = f.key === 'spend' ? Math.abs(haveNum - w) < 1 : haveNum === w;
        if (close) return;
        var status = (have === '' || haveNum === 0) ? 'MISSING' : 'DIFFERS';
        if (status === 'DIFFERS' && w === 0) return;   // sheet has a value the source lacks — keep it, not an error
        counts[status]++;
        var t = tally[r.name] || (tally[r.name] = {});
        t[f.name + ' ' + status] = (t[f.name + ' ' + status] || 0) + 1;
        var line = '  ' + status + '  ' + r.name + ' ' + f.name + ': sheet ' + (have === '' ? 'blank' : have) + ' → source ' + w;
        var write = status === 'MISSING' ? fill
                  : (mode === 'match' && f.key !== 'spend') || (mode === 'matchSpend' && f.key === 'spend');
        if (write) {
          sheet.getRange(r.row, f.col).setValue(w);
          counts.filled++;
          line += '  ✏️ filled';
        }
        lines.push(line);
      });
      if (want.spend > 0 && want.optin === 0 && want.results === 0) {
        counts['NO DATA']++;
        lines.push('  NO DATA  ' + r.name + ': spent ₹' + Math.round(want.spend) + ' but sources report 0 optins and 0 results');
      }
    });
    Logger.log('── ' + dateStr + (lines.length ? '' : ': all cells match the sources'));
    lines.forEach(function(l) { Logger.log(l); });
  }

  Logger.log('═══ Summary: ' + counts.MISSING + ' missing, ' + counts.DIFFERS + ' different, ' + counts['NO DATA'] + ' no-data'
           + (fill ? ', ' + counts.filled + ' filled' : '') + ' ═══');
  Object.keys(tally).forEach(function(name) {
    Logger.log('  ' + name + ': ' + Object.keys(tally[name]).map(function(k) { return k + ' ×' + tally[name][k]; }).join(', '));
  });
}

// Campaign rows of one date block: [{ name, row, values: [A..G] }]
function auditBlockRows(sheet, dispDate, tz) {
  var data = sheet.getDataRange().getValues(), out = [], inBlock = false;
  for (var i = CONFIG.DATA_START_ROW - 1; i < data.length; i++) {
    var a = data[i][0];
    if (a instanceof Date) {
      if (inBlock) break;
      inBlock = fmtDate(new Date(a), tz, 'd-MMM-yyyy') === dispDate;
    }
    var name = String(data[i][1] || '').replace(/\s+/g, ' ').trim();
    if (inBlock && name) out.push({ name: name, row: i + 1, values: data[i].slice(0, 7) });
  }
  return out;
}
