// ── EMAIL-ONLY LOGIN ──────────────────────────────────────────────────────────
function validateEmail(email) {
  try {
    email = (email || "").toString().trim().toLowerCase();
    if (!email) return JSON.stringify({ error: "Please enter your email address." });

    var sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Dashboard Access");
    if (!sheet) return JSON.stringify({ error: "Dashboard Access tab not found." });
    var data = sheet.getDataRange().getValues();

    for (var r = 1; r < data.length; r++) {
      var rowEmail = (data[r][0] || "").toString().trim().toLowerCase();
      var rowRole  = (data[r][1] || "").toString().trim().toUpperCase();
      if (rowEmail === email && rowRole !== "") {
        return JSON.stringify({ success: true, role: rowRole, groups: getVisibleGroups(rowRole) });
      }
    }
    return JSON.stringify({ error: "This email is not authorized to access the dashboard." });
  } catch(e) { return JSON.stringify({ error: e.toString() }); }
}

