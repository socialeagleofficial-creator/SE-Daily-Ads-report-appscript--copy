// ── LOGIN ─────────────────────────────────────────────────────────────────────
function validateLogin(email, pin) {
  try {
    email = (email || "").toString().trim().toLowerCase();
    pin   = (pin   || "").toString().trim();
    if (!email || !pin) return JSON.stringify({ error: "Please enter both email and PIN." });

    var sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Dashboard Access");
    if (!sheet) return JSON.stringify({ error: "Dashboard Access tab not found." });
    var data = sheet.getDataRange().getValues();

    var props   = PropertiesService.getScriptProperties();
    var failKey = "fails_" + email.replace(/[^a-z0-9]/g, "_");
    var lockKey = "lock_"  + email.replace(/[^a-z0-9]/g, "_");
    var lockUntil = Number(props.getProperty(lockKey) || 0);
    if (lockUntil > Date.now()) {
      var mins = Math.ceil((lockUntil - Date.now()) / 60000);
      return JSON.stringify({ error: "Too many failed attempts. Try again in " + mins + " minute(s)." });
    }

    for (var r = 1; r < data.length; r++) {
      var rowEmail = (data[r][0] || "").toString().trim().toLowerCase();
      var rowRole  = (data[r][1] || "").toString().trim().toUpperCase();
      var rowPIN   = (data[r][2] || "").toString().trim();
      if (rowEmail === email) {
        if (!rowPIN) return JSON.stringify({ error: "No PIN set. Contact admin." });
        if (rowPIN === pin) {
          props.deleteProperty(failKey);
          props.deleteProperty(lockKey);
          return JSON.stringify({ success: true, role: rowRole, groups: getVisibleGroups(rowRole) });
        } else {
          var fails = Number(props.getProperty(failKey) || 0) + 1;
          props.setProperty(failKey, fails.toString());
          if (fails >= 5) {
            props.setProperty(lockKey, (Date.now() + 15 * 60 * 1000).toString());
            props.deleteProperty(failKey);
            return JSON.stringify({ error: "Too many failed attempts. Locked for 15 minutes." });
          }
          return JSON.stringify({ error: "Incorrect PIN. " + (5 - fails) + " attempt(s) remaining." });
        }
      }
    }
    return JSON.stringify({ error: "Email not authorized." });
  } catch(e) { return JSON.stringify({ error: e.toString() }); }
}

function getVisibleGroups(role) {
  if (role === "MASTER" || role === "ALL") return ["AI", "DM", "SOS"];
  if (role === "AI")  return ["AI"];
  if (role === "DM")  return ["DM"];
  if (role === "SOS") return ["SOS"];
  return [];
}

// ── MAIN DATA LOADER ──────────────────────────────────────────────────────────
function loadCurrentData(groupsJson) {
  try {
    var groups = JSON.parse(groupsJson);
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var tz = Session.getScriptTimeZone();
    var today = new Date();
    var yesterday = new Date(today);
    yesterday.setDate(today.getDate() - 1);

    var monthName = Utilities.formatDate(yesterday, tz, "MMMM").toUpperCase();
    var yearShort = Utilities.formatDate(yesterday, tz, "yy");
    var sheet = ss.getSheetByName(monthName + " " + yearShort);
    if (!sheet) {
      sheet = ss.getSheetByName(Utilities.formatDate(yesterday, tz, "MMM").toUpperCase() + " " + yearShort);
    }

    var data = sheet ? sheet.getDataRange().getValues() : [];
    var yesterdayStr = Utilities.formatDate(yesterday, tz, "d-MMM-yyyy");

    var dateBlocks = [];
    for (var i = 15; i < data.length; i++) {
      if (data[i][0] instanceof Date) {
        dateBlocks.push({
          row: i,
          dateStr: Utilities.formatDate(new Date(data[i][0]), tz, "d-MMM-yyyy"),
          time: new Date(data[i][0]).getTime()
        });
      }
    }

    var dayOfWeek = yesterday.getDay();
    var daysFromMonday = dayOfWeek === 0 ? 6 : dayOfWeek - 1;
    var currentWeekStart = new Date(yesterday);
    currentWeekStart.setDate(yesterday.getDate() - daysFromMonday);
    currentWeekStart.setHours(0,0,0,0);
    var monthStart = new Date(yesterday.getFullYear(), yesterday.getMonth(), 1);
    var prevWeeks  = buildPrevWeeks(monthStart, currentWeekStart, tz);

    // Get current month short name for conversion tab lookup e.g. "July"
    var currentMonthLabel = Utilities.formatDate(yesterday, tz, "MMMM"); // e.g. "August"

    var result = {};
    groups.forEach(function(group) {
      var courses = COURSE_GROUPS[group];
      result[group] = {
        yesterday:     getYesterday(data, dateBlocks, courses, yesterdayStr),
        currentWeek:   aggregateWeek(data, dateBlocks, courses, currentWeekStart, yesterday),
        previousWeeks: prevWeeks.map(function(w) {
          return {
            label:    w.label,
            startStr: Utilities.formatDate(w.start, tz, "d MMM"),
            endStr:   Utilities.formatDate(w.end,   tz, "d MMM"),
            rows:     aggregateWeek(data, dateBlocks, courses, w.start, w.end)
          };
        }),
        monthly:    getMonthSummary(data, courses),
        dailyLog:   getDailyLog(data, courses, tz),
        conversion: [], // loaded lazily when Monthly tab is clicked
        webinars:   []  // loaded lazily when Webinar tab is clicked
      };
    });

    return JSON.stringify(result);
  } catch(e) { return JSON.stringify({ error: e.toString() }); }
}

// ── CONVERSION DATA: fetch tab named e.g. "DM - July", "AI - July" ───────────
function getConversionForMonth(group, monthLabel) {
  // monthLabel = full month name e.g. "July", "August"
  try {
    var ssId, tabName;
    if (group === "AI") {
      ssId    = MONTHLY_AI_ID;
      tabName = "AI - " + monthLabel;
    } else if (group === "DM") {
      ssId    = MONTHLY_DM_SOS_ID;
      tabName = "DM - " + monthLabel;
    } else if (group === "SOS") {
      ssId    = MONTHLY_DM_SOS_ID;
      tabName = "SOS - " + monthLabel;
    } else { return []; }

    var ss    = SpreadsheetApp.openById(ssId);
    var sheet = ss.getSheetByName(tabName);
    if (!sheet) return []; // tab doesn't exist yet — return empty silently

    var data = sheet.getDataRange().getValues();
    return parseMonthlyConv(data, COURSE_GROUPS[group]);
  } catch(e) {
    Logger.log("Conv error [" + group + " " + monthLabel + "]: " + e);
    return [];
  }
}

