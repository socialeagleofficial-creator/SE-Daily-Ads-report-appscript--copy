// ── DAILY LOG ─────────────────────────────────────────────────────────────────
function getDailyLog(data, courses, tz) {
  var optinCol = detectOptinCol(data);
  var dateBlocks = [];
  for (var i = 15; i < data.length; i++) {
    if (data[i][0] instanceof Date) {
      dateBlocks.push({
        row: i,
        dateStr: Utilities.formatDate(new Date(data[i][0]), tz, 'd-MMM-yyyy'),
        time: new Date(data[i][0]).getTime()
      });
    }
  }
  var days = [];
  dateBlocks.forEach(function(b, idx) {
    var endRow = idx+1 < dateBlocks.length ? dateBlocks[idx+1].row : data.length;
    var dayRows = [];
    for (var r = b.row; r < endRow; r++) {
      var cName = (data[r][1]||'').toString().replace(/\s+/g, ' ').trim();
      var cUp = cName.toUpperCase();
      if (!courses.some(function(c){return c.toUpperCase()===cUp;})) continue;
      var spend = Number(data[r][2])||0;
      if (spend <= 0) continue;
      dayRows.push({
        name:    cName,
        label:   RESULT_LABELS[cUp]||'Results',
        spend:   spend,
        results: Number(data[r][4])||0,
        cpr:     Number(data[r][5])||0,
        optin:   optinCol>=0 ? (Number(data[r][optinCol])||0) : 0
      });
    }
    if (dayRows.length) days.push({ date: b.dateStr, time: b.time, rows: dayRows });
  });
  return days.sort(function(a,b){return b.time-a.time;});
}
function getYesterday(data, dateBlocks, courses, yesterdayStr) {
  var block = null, blockIdx = -1;
  for (var i = 0; i < dateBlocks.length; i++) {
    if (dateBlocks[i].dateStr === yesterdayStr) { block = dateBlocks[i]; blockIdx = i; break; }
  }
  if (!block) return [];
  var endRow = blockIdx + 1 < dateBlocks.length ? dateBlocks[blockIdx+1].row : data.length;

  // Detect optin column by reading the daily log header row
  var optinCol = detectOptinCol(data);

  var rows = [];
  for (var r = block.row; r < endRow; r++) {
    var cName = (data[r][1]||"").toString().replace(/\s+/g, " ").trim();
    var cUp   = cName.toUpperCase();
    if (courses.some(function(c){return c.toUpperCase()===cUp;})) {
      var spend = Number(data[r][2])||0;
      if (spend > 0) rows.push({ name:cName, spend:spend,
        results:Number(data[r][4])||0, cpr:Number(data[r][5])||0,
        optin: optinCol >= 0 ? (Number(data[r][optinCol])||0) : 0,
        label:RESULT_LABELS[cUp]||"Results"});
    }
  }
  return rows;
}

// Find the column index of "Optin" in the daily log header
// Searches for a row where col 0 = "Date" and col 1 = "Course Name"
function detectOptinCol(data) {
  for (var i = 0; i < data.length; i++) {
    var col0 = (data[i][0]||"").toString().trim().toLowerCase();
    var col1 = (data[i][1]||"").toString().trim().toLowerCase();
    if (col0 === "date" && (col1 === "course name" || col1 === "course")) {
      // This is the header row — find "optin" column
      for (var c = 0; c < data[i].length; c++) {
        if ((data[i][c]||"").toString().trim().toLowerCase() === "optin") {
          return c;
        }
      }
      return -1; // header found but no optin column
    }
  }
  return -1; // no header found
}

function aggregateWeek(data, dateBlocks, courses, startDate, endDate) {
  var totals = {};
  courses.forEach(function(c) {
    totals[c.toUpperCase()]={name:c,spend:0,results:0,optin:0,label:RESULT_LABELS[c.toUpperCase()]||"Results"};
  });
  var sd=new Date(startDate);sd.setHours(0,0,0,0);
  var ed=new Date(endDate);ed.setHours(23,59,59,999);
  var optinCol = detectOptinCol(data);
  dateBlocks.forEach(function(b,idx) {
    var bd=new Date(b.time);
    if(bd>=sd&&bd<=ed){
      var bEnd=idx+1<dateBlocks.length?dateBlocks[idx+1].row:data.length;
      for(var r=b.row;r<bEnd;r++){
        var cn=(data[r][1]||"").toString().replace(/\s+/g," ").trim().toUpperCase();
        if(totals[cn]&&Number(data[r][2])>0){
          totals[cn].spend+=Number(data[r][2])||0;
          totals[cn].results+=Number(data[r][4])||0;
          totals[cn].optin+=optinCol>=0?(Number(data[r][optinCol])||0):0;
        }
      }
    }
  });
  return Object.keys(totals).map(function(k){return totals[k];})
    .filter(function(c){return c.spend>0;})
    .map(function(c){return{name:c.name,spend:c.spend,results:c.results,optin:c.optin,
      cpr:c.results>0?c.spend/c.results:0,label:c.label};});
}

function getMonthSummary(data, courses) {
  // Find the summary table header row to detect column positions
  // Look for row with "Course Name" in col 0 and "Monthly Spend" in col 1
  var summaryHeaderRow = -1;
  var optinSummaryCol = -1;
  for (var i = 0; i < Math.min(20, data.length); i++) {
    var c0 = (data[i][0]||"").toString().trim().toLowerCase();
    var c1 = (data[i][1]||"").toString().trim().toLowerCase();
    if (c0 === "course name" && c1 === "monthly spend") {
      summaryHeaderRow = i;
      // Find "Total Optin" column in this header
      for (var c = 0; c < data[i].length; c++) {
        var hdr = (data[i][c]||"").toString().trim().toLowerCase();
        if (hdr === "total optin" || hdr === "total optins") {
          optinSummaryCol = c;
          break;
        }
      }
      break;
    }
  }

  var startRow = summaryHeaderRow >= 0 ? summaryHeaderRow + 1 : 2;
  var rows=[];
  for(var r=startRow;r<=startRow+15;r++){
    if(!data[r])continue;
    var cName=(data[r][0]||"").toString().replace(/\s+/g," ").trim();
    if(!cName || cName.toLowerCase()==="course name")continue;
    var cUp=cName.toUpperCase();
    if(!courses.some(function(c){return c.toUpperCase()===cUp;}))continue;
    var spend=Number(data[r][1])||0;
    if(spend>0){
      var res=Number(data[r][9])||0;
      rows.push({name:cName,spend:spend,results:res,
        optin: optinSummaryCol>=0 ? (Number(data[r][optinSummaryCol])||0) : 0,
        cpr:res>0?spend/res:0,label:RESULT_LABELS[cUp]||"Results"});
    }
  }
  return rows;
}

function buildPrevWeeks(monthStart, currentWeekStart, tz) {
  var weeks=[],wStart=new Date(monthStart);
  var day=wStart.getDay();
  if(day!==1)wStart.setDate(wStart.getDate()-(day===0?6:day-1));
  var weekNum=1,csTime=currentWeekStart.getTime();
  while(wStart.getTime()<csTime){
    var wEnd=new Date(wStart);wEnd.setDate(wStart.getDate()+6);wEnd.setHours(23,59,59,999);
    var wEndC=wEnd.getTime()<csTime?wEnd:new Date(csTime-1);
    weeks.push({label:"Week "+weekNum,start:new Date(wStart),end:new Date(wEndC)});
    wStart.setDate(wStart.getDate()+7);weekNum++;
  }
  return weeks;
}

