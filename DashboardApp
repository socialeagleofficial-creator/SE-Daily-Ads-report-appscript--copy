  } catch(e) { return JSON.stringify({ error: e.toString() }); }
}

// ── WEBINAR DATA: read all tabs for a group from webinar sheets ───────────────
function getWebinarData(group) {
  try {
    var ssId = (group === "AI") ? WEBINAR_AI_ID : WEBINAR_DM_SOS_ID;
    var tabs = WEBINAR_TABS[group] || [];
    var ss   = SpreadsheetApp.openById(ssId);
    var result = []; // array of { tabName, headers, rows }

    tabs.forEach(function(tabName) {
      var sheet = ss.getSheetByName(tabName);
      if (!sheet) return;
      var data = sheet.getDataRange().getValues();
      if (data.length < 2) return;

      // Read headers as-is (preserve original casing for display)
      var headers = data[0].map(function(h){ return (h||"").toString().trim(); });
      // Filter out empty trailing headers
      while (headers.length && !headers[headers.length-1]) headers.pop();
      if (!headers.length) return;

      var dataRows = [];
      for (var r = 1; r < data.length; r++) {
        // Skip fully empty rows
        var hasData = data[r].some(function(c){ return (c||"").toString().trim() !== ""; });
        if (!hasData) continue;
        // Build row as array matching headers
        var rowArr = headers.map(function(h, ci){
          return (data[r][ci] === undefined || data[r][ci] === null) ? "" : data[r][ci].toString().trim();
        });
        // Skip rows where first column (Date) is empty
        if (!rowArr[0]) continue;
        dataRows.push(rowArr);
      }

      if (!dataRows.length) return;
      dataRows.reverse(); // newest first

      result.push({
        tabName: tabName,
        headers: headers,
        rows:    dataRows
      });
    });

    return result;
  } catch(e) {
    Logger.log("Webinar error [" + group + "]: " + e);
    return [];
  }
}

// ── PARSE MONTHLY CONVERSION ──────────────────────────────────────────────────
// Dynamic header detection — reads all columns from sheet
// Actual columns: Course, Spend, Optin, Result, CPR, RevThruReg, ConvType,
//   Conversions, ConvRate, CAC, ValuePerConv, TotalConvVal, TotalRevenue,
//   ROAS, BudgetEst, ExpectedResults, ExpectedConversions, ExpectedRevenue
function parseMonthlyConv(data, courses) {
  if (!data || data.length < 2) return [];

  // Find header row — look for "Course Name" in col 0
  var headerRow = -1;
  for (var i = 0; i < Math.min(data.length, 10); i++) {
    var c0 = (data[i][0] || "").toString().trim().toLowerCase();
    if (c0 === "course name" || c0 === "course") { headerRow = i; break; }
  }
  if (headerRow === -1) return [];

  // Map headers to column indices dynamically
  var headers = data[headerRow].map(function(h){ return (h||"").toString().trim(); });
  var hLow    = headers.map(function(h){ return h.toLowerCase(); });

  function col(keywords) {
    for (var k = 0; k < keywords.length; k++) {
      for (var i = 0; i < hLow.length; i++) {
        if (hLow[i].indexOf(keywords[k]) !== -1) return i;
      }
    }
    return -1;
  }

  var ci = {
    name:        0,
    spend:       col(['monthly spend','spend']),
    optin:       col(['optin']),
    result:      col(['result']),
    cpr:         col(['cpr']),
    revThruReg:  col(['revenue thru reg','revenue thru registration']),
    convType:    col(['conversion type','conv type']),
    conversions: col(['conversions']),
    convRate:    col(['conversion rate','conv rate']),
    cac:         col(['cac']),
    valuePerConv:col(['value per conv']),
    totalConvVal:col(['total conversion value','total conv value']),
    totalRevenue:col(['total revenue']),
    roas:        col(['roas']),
    budgetEst:   col(['budget estimation','budget est']),
    expResults:  col(['expected results']),
    expConv:     col(['expected conversions','expected conv']),
    expRevenue:  col(['expected revenue'])
  };

  var rows = [];
  for (var r = headerRow + 1; r < data.length; r++) {
    var cName = (data[r][0] || "").toString().replace(/\s+/g, " ").trim();
    if (!cName || cName.toLowerCase() === "total" || cName.toLowerCase() === "course name") continue;
    var cUp = cName.toUpperCase();
    if (!courses.some(function(c) { return c.toUpperCase() === cUp; })) continue;
    var spend = ci.spend >= 0 ? cleanNum(data[r][ci.spend]) : 0;
    if (spend <= 0) continue;

    var row = {
      name:         cName,
      spend:        spend,
      optin:        ci.optin        >= 0 ? cleanNum(data[r][ci.optin])        : 0,
      result:       ci.result       >= 0 ? cleanNum(data[r][ci.result])       : 0,
      cpr:          ci.cpr          >= 0 ? cleanNum(data[r][ci.cpr])          : 0,
      revThruReg:   ci.revThruReg   >= 0 ? cleanNum(data[r][ci.revThruReg])   : 0,
      convType:     ci.convType     >= 0 ? (data[r][ci.convType]||"").toString().trim() : "",
      conversions:  ci.conversions  >= 0 ? cleanNum(data[r][ci.conversions])  : 0,
      convRate:     ci.convRate     >= 0 ? cleanPct(data[r][ci.convRate])     : 0,
      cac:          ci.cac          >= 0 ? cleanNum(data[r][ci.cac])          : 0,
      valuePerConv: ci.valuePerConv >= 0 ? cleanNum(data[r][ci.valuePerConv]) : 0,
      totalConvVal: ci.totalConvVal >= 0 ? cleanNum(data[r][ci.totalConvVal]) : 0,
      totalRevenue: ci.totalRevenue >= 0 ? cleanNum(data[r][ci.totalRevenue]) : 0,
      roas:         ci.roas         >= 0 ? cleanNum(data[r][ci.roas])         : 0,
      budgetEst:    ci.budgetEst    >= 0 ? cleanNum(data[r][ci.budgetEst])    : 0,
      expResults:   ci.expResults   >= 0 ? cleanNum(data[r][ci.expResults])   : 0,
      expConv:      ci.expConv      >= 0 ? cleanNum(data[r][ci.expConv])      : 0,
      expRevenue:   ci.expRevenue   >= 0 ? cleanNum(data[r][ci.expRevenue])   : 0
    };
    rows.push(row);
  }
  return rows;
}

// ── HELPERS ───────────────────────────────────────────────────────────────────
function findCol(headers, options) {
  for (var i = 0; i < options.length; i++) {
    var idx = headers.indexOf(options[i]);
    if (idx !== -1) return idx;
  }
  return -1;
}

function cleanNum(val) {
  if (!val && val !== 0) return 0;
  var s = val.toString().replace(/[₹,\s]/g,"");
  var n = parseFloat(s);
  return isNaN(n) ? 0 : n;
}

function cleanPct(val) {
  if (!val && val !== 0) return 0;
  var s = val.toString().replace(/[%\s]/g,"");
  var n = parseFloat(s);
  if (isNaN(n)) return 0;
  // Google Sheets stores % as decimal (e.g. 0.85 = 85%)
  // If value is between -1 and 1 (exclusive), multiply by 100
  if (n > -1 && n < 1 && n !== 0) return n * 100;
  return n;
}

// ── AVAILABLE MONTHS ──────────────────────────────────────────────────────────
function getAvailableMonths() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var monthOrder = ["JANUARY","FEBRUARY","MARCH","APRIL","MAY","JUNE",
                    "JULY","AUGUST","SEPTEMBER","OCTOBER","NOVEMBER","DECEMBER"];
  var result = [];
  ss.getSheets().forEach(function(s) {
    var parts = s.getName().trim().split(" ");
    if (parts.length === 2 && monthOrder.indexOf(parts[0]) !== -1 && parts[1].length === 2) {
      result.push(s.getName());
    }
  });
  result.sort(function(a, b) {
    var pa = a.split(" "), pb = b.split(" ");
    var ya = parseInt("20"+pa[1]), yb = parseInt("20"+pb[1]);
    return ya !== yb ? ya-yb : monthOrder.indexOf(pa[0])-monthOrder.indexOf(pb[0]);
  });
  return result;
}

