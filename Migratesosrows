// MigrateSosRows.gs
// Run ONCE to split every "SOS" row into "SOS Call Booking" + "SOS Forms"
// across all date blocks in the active sheet tab.
//
// WHAT IT DOES:
//   1. Scans every row in the sheet from bottom to top
//   2. Finds rows where Col B = "SOS" (exact match, case-insensitive)
//   3. Renames that row to "SOS Call Booking"
//   4. Inserts a new "SOS Forms" row immediately after it (empty data)
//
// WHAT IT DOES NOT TOUCH:
//   - "SOS MS" rows (left unchanged)
//   - Any row that already says "SOS Call Booking" or "SOS Forms"
//   - Summary table rows (rows 1-14 are skipped)
//   - Any data columns — only Col B label changes
//
// HOW TO USE:
//   1. Open Apps Script in SE - Daily Ads Report
//   2. Paste this as a new file: MigrateSosRows.gs
//   3. Select migrateSosRows → Run
//   4. Then run updateAutoFillForSosSplit() to update AutoFill script config
// ══════════════════════════════════════════════════════════════════════════════

function migrateSosRows() {
  var ss    = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getActiveSheet();
  var tabName = sheet.getName();

  Logger.log('Running SOS migration on tab: ' + tabName);

  var data     = sheet.getDataRange().getValues();
  var numRows  = data.length;
  var migrated = 0;
  var skipped  = 0;

  // Scan bottom to top so row insertions don't shift indices
  for (var i = numRows - 1; i >= 14; i--) { // skip summary (rows 1-14)
    var colB = (data[i][1] || '').toString().trim();

    // Skip already migrated rows
    if (colB.toUpperCase() === 'SOS CALL BOOKING' ||
        colB.toUpperCase() === 'SOS FORMS') {
      skipped++;
      continue;
    }

    // Only process exact "SOS" rows (not SOS MS)
    if (colB.toUpperCase() === 'SOS') {
      var sheetRow = i + 1; // 1-based

      // Step 1: Rename "SOS" → "SOS Call Booking"
      sheet.getRange(sheetRow, 2).setValue('SOS Call Booking');

      // Step 2: Insert new row after this row
      sheet.insertRowAfter(sheetRow);

      // Step 3: Write "SOS Forms" in Col B of the new row
      sheet.getRange(sheetRow + 1, 2).setValue('SOS Forms');

      Logger.log('✅ Row ' + sheetRow + ': SOS → SOS Call Booking | inserted SOS Forms at row ' + (sheetRow + 1));
      migrated++;

      // Re-read data since we inserted a row
      data    = sheet.getDataRange().getValues();
      numRows = data.length;
    }
  }

  Logger.log('══ Migration complete ══');
  Logger.log('Migrated: ' + migrated + ' SOS rows');
  Logger.log('Skipped (already done): ' + skipped);
  Logger.log('');
  Logger.log('Next steps:');
  Logger.log('1. Run testMidnightRun() to fill data into the new SOS Call Booking + SOS Forms rows');
  Logger.log('2. Update CAMPAIGN_MAP, COURSE_ORDER, and matchCourseKey in AutoFill_v2_updated.gs (see comments below)');
}


