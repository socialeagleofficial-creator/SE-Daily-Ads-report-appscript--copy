// TEST — run this manually to verify before going live
// ══════════════════════════════════════════════════════════════════════════════
function testSyncMonthlyToAdSpent() {
  Logger.log('=== TEST RUN ===');
  syncMonthlyToAdSpent();
}


// ── HELPER: find column index by keyword match ────────────────────────────────
function findColIndex(headers, keywords) {
  for (var k = 0; k < keywords.length; k++) {
    for (var i = 0; i < headers.length; i++) {
      if (headers[i].indexOf(keywords[k]) !== -1) return i;
    }
  }
  return -1;
}