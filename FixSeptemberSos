// ══════════════════════════════════════════════════════════════════════════════
// FixSeptemberSos.gs
// Run ONCE: SEPTEMBER 26's summary row "SOS" totals ₹0 because every daily block uses
// "SOS Call Booking" + "SOS Forms" (the SOS split). This:
//   1. Report (SEPTEMBER 26): renames summary "SOS" → "SOS Call Booking" and inserts a
//      "SOS Forms" row below it (formulas + formats copied, targets left blank).
//   2. SE - 2026 AD Spent data ("SOS - September"): same rename + inserted row, so the
//      sync has somewhere to write both.
//   3. Runs syncMonthlyToAdSpent() and logs the new September SOS totals.
// Safe to re-run: skips any part that's already done.
// ══════════════════════════════════════════════════════════════════════════════

var FIX_SOS = {
  REPORT_ID: '1s7fUe5d0pwg40D4CBzoVbXB6ZYz1Xy8hUQZ2R3Ku-w8',
  REPORT_TAB: 'SEPTEMBER 26',
  AD_ID: '1jCJnYqbHM4Ymrk8-Sp4AwK-XOhRmNroIoFd1GbJmQoM',
  AD_TAB: 'SOS - September',
  TARGET_COLS: [18, 5],   // R:V in the report summary
};

function fixSeptemberSos() {
  fixSosReportSummary();
  fixSosAdSpentTab();
  SpreadsheetApp.flush();
  Logger.log('Running syncMonthlyToAdSpent…');
  syncMonthlyToAdSpent();

  var tab = SpreadsheetApp.openById(FIX_SOS.REPORT_ID).getSheetByName(FIX_SOS.REPORT_TAB);
  var vals = tab.getRange(3, 1, 13, 14).getDisplayValues();
  vals.forEach(function(r, i) {
    if (/^SOS/i.test(r[0])) Logger.log('  Summary row ' + (i + 3) + ': ' + r[0] + ' | Monthly Spend ' + r[1] + ' | Total Result ' + r[9] + ' | Total Optin ' + r[13]);
  });
}

function fixSosReportSummary() {
  var tab = SpreadsheetApp.openById(FIX_SOS.REPORT_ID).getSheetByName(FIX_SOS.REPORT_TAB);
  if (!tab) throw new Error(FIX_SOS.REPORT_TAB + ' not found');
  var names = tab.getRange(1, 1, 15, 1).getValues().map(function(r) { return String(r[0]).trim().toUpperCase(); });
  if (names.indexOf('SOS FORMS') !== -1) { Logger.log('⏭ Report summary already has SOS Forms — skipped.'); return; }
  var idx = names.indexOf('SOS');
  if (idx === -1) throw new Error('no "SOS" row in the ' + FIX_SOS.REPORT_TAB + ' summary');
  var row = idx + 1, lastCol = tab.getLastColumn();

  tab.getRange(row, 1).setValue('SOS Call Booking');
  tab.insertRowAfter(row);
  tab.getRange(row, 1, 1, lastCol).copyTo(tab.getRange(row + 1, 1, 1, lastCol));  // formulas follow $A
  tab.getRange(row + 1, 1).setValue('SOS Forms');
  tab.getRange(row + 1, FIX_SOS.TARGET_COLS[0], 1, FIX_SOS.TARGET_COLS[1]).clearContent();
  var frozen = tab.getFrozenRows();
  if (frozen >= row) tab.setFrozenRows(frozen + 1);
  Logger.log('✅ ' + FIX_SOS.REPORT_TAB + ': row ' + row + ' "SOS" → "SOS Call Booking"; inserted "SOS Forms" at row ' + (row + 1) + '.');
}

function fixSosAdSpentTab() {
  var tab = SpreadsheetApp.openById(FIX_SOS.AD_ID).getSheetByName(FIX_SOS.AD_TAB);
  if (!tab) { Logger.log('⚠️ "' + FIX_SOS.AD_TAB + '" not found — AD Spent part skipped.'); return; }
  var data = tab.getDataRange().getValues();
  var names = data.map(function(r) { return String(r[0]).trim().toUpperCase(); });
  if (names.indexOf('SOS FORMS') !== -1) { Logger.log('⏭ "' + FIX_SOS.AD_TAB + '" already has SOS Forms — skipped.'); return; }
  var idx = names.indexOf('SOS');
  if (idx === -1) { Logger.log('⚠️ No "SOS" row in "' + FIX_SOS.AD_TAB + '" — AD Spent part skipped.'); return; }
  var row = idx + 1, lastCol = tab.getLastColumn();

  tab.getRange(row, 1).setValue('SOS Call Booking');
  tab.insertRowAfter(row);
  var src = tab.getRange(row, 1, 1, lastCol), dst = tab.getRange(row + 1, 1, 1, lastCol);
  src.copyTo(dst);
  // keep per-row formulas (CPR etc.), clear typed figures
  var fx = dst.getFormulas()[0];
  fx.forEach(function(f, c) { if (!f && c > 0) tab.getRange(row + 1, c + 1).clearContent(); });
  tab.getRange(row + 1, 1).setValue('SOS Forms');
  Logger.log('✅ "' + FIX_SOS.AD_TAB + '": "SOS" → "SOS Call Booking"; inserted "SOS Forms" at row ' + (row + 1) + '.');
}
